#!/usr/bin/env zsh
# ============================================================================
# claude-auto-window — keep a Claude five-hour usage window perpetually open
# ============================================================================
# Goal: always have a 5-hour session window running, back to back, spending as
# few tokens as possible. When a window has lapsed, this opens a fresh one with
# a single trivial request — that one request is enough to anchor a new 5-hour
# window, so the next time you actually need Claude there is no cold-start wait.
#
# Two opener strategies (CLAUDE_AUTO_WINDOW_OPENER / --opener):
#   http (default) — replicate the request Claude Code itself sends: one raw
#     POST /v1/messages authenticated with the stored OAuth token, spoofing the
#     Claude Code identity (beta header + system prompt) so the subscription
#     token is accepted. No tmux, no claude binary — the lightest path. Falls
#     back to the tmux opener when the token is expired/absent (only a real
#     claude launch refreshes it) or the request is auth-rejected. Validated
#     live 2026-07-27.
#   tmux — drive a *real interactive* Claude Code session inside a throwaway
#     tmux session: send one prompt, wait for the reply, quit, tear the session
#     down. Heaviest, but the most faithful path, and it self-heals an expired
#     access token on its own. This is deliberately NOT the headless `claude -p`
#     approach (see ../claude-auto-window-old for that variant) — we drive the
#     genuine TUI path through tmux.
#
# The window check reads Claude Code's own OAuth usage endpoint directly (token
# resolution + fetch are inlined below) — no Anthropic API key required.
#
# ---------------------------------------------------------------------------
# Modes (pick one; --once is the default)
#   --run          Fire one starter now, no checks, no jitter. ("just do it")
#   --once         Check the window; only if none is open, jitter then fire.
#   --daemon       Service every profile, sleeping until the next window expires
#                  (systemd/launchd target). Not a fixed-interval poll.
#   --status       Print the current five-hour session state and exit.
#
# Profile (multi-account — one daemon/run services N profiles)
#   Default: let Claude Code resolve its own profile (~/.claude) — we never set
#   CLAUDE_CONFIG_DIR for the launch. Both flags below are REPEATABLE and
#   accumulate (in order), so a single --daemon/--once/--status/--reset can hold
#   N logins open, each checked independently against its own stored OAuth login
#   with per-profile failure isolation:
#     --config-dir PATH   explicit Claude profile dir (sets CLAUDE_CONFIG_DIR)
#     --profile NAME      default | <abs path> | a claude-profile profile name
#   (profile NAMES other than `default` are resolved from claude-profile's config
#    — github.com/deviationist/claude-profile — so they're defined per-machine
#    there, not hardcoded here.) Or set CLAUDE_AUTO_WINDOW_PROFILES="a b" once.
#
# Balance gate
#   We only anchor a window when the STARTER's own model is still plan-covered
#   (i.e. would NOT overflow to paid usage credits). The starter is a tiny
#   request on the cheapest model, so the governing plan bucket is the overall
#   weekly cap `weekly_all` (plus any model-scoped weekly cap matching the
#   starter model). If that's exhausted, the window is worthless anyway (no plan
#   allowance to spend inside it) and firing would burn credits — so we stand
#   down. Threshold: CLAUDE_AUTO_WINDOW_WEEKLY_MAX_PERCENT (default 100).
#
# Observability
#   Logs go to stdout/stderr always (journal-friendly). Opt in to a file with
#   --log PATH (or CLAUDE_AUTO_WINDOW_LOG). Nothing is written to a file unless
#   you ask for it.
#
# This file is both executable and source-able:
#   ./claude-auto-window --once
#   source ./claude-auto-window && claude-auto-window-once
# ============================================================================

typeset -g CLAUDE_AUTO_WINDOW_VERSION="1.4.0"

# ----------------------------------------------------------------------------
# Logging — stdout/stderr always; append to $CLAUDE_AUTO_WINDOW_LOG if opted in.
# ----------------------------------------------------------------------------
_caw_log() {
  emulate -L zsh
  local level="$1"; shift
  local line="$(date '+%Y-%m-%d %H:%M:%S') [$level] $*"
  # --quiet (CLAUDE_AUTO_WINDOW_QUIET=1) suppresses console output so a cron job
  # doesn't email on every routine run — logs still go to the file. systemd/
  # journal users leave it off so the journal keeps capturing output.
  if [[ "${CLAUDE_AUTO_WINDOW_QUIET:-0}" != 1 ]]; then
    if [[ "$level" == "ERROR" || "$level" == "WARN" ]]; then
      print -u2 -r -- "$line"
    else
      print -r -- "$line"
    fi
  fi
  [[ -n "${CLAUDE_AUTO_WINDOW_LOG:-}" ]] && print -r -- "$line" >> "$CLAUDE_AUTO_WINDOW_LOG"
}

# ----------------------------------------------------------------------------
# Color — for the human-facing `--status` output ONLY.
#
# _caw_log output is deliberately NEVER colored: it goes to journald, cron mail
# and --log files, where escape codes are corruption rather than decoration.
#
# CLAUDE_AUTO_WINDOW_COLOR: auto (default) = color only when stdout is a TTY;
# always/1 = color even through a pipe (what the README-SVG generator needs,
# since it captures output non-interactively); never/0 = plain. NO_COLOR always
# wins, whatever its value (https://no-color.org).
# ----------------------------------------------------------------------------
typeset -g _caw_c_reset="" _caw_c_bold="" _caw_c_dim="" \
           _caw_c_red="" _caw_c_green="" _caw_c_yellow=""

_caw_color_init() {
  emulate -L zsh
  local mode="${CLAUDE_AUTO_WINDOW_COLOR:-auto}" on=0
  case "$mode" in
    1|yes|always) on=1 ;;
    0|no|never)   on=0 ;;
    auto|"")      [[ -t 1 ]] && on=1 ;;
    *)            _caw_log WARN "CLAUDE_AUTO_WINDOW_COLOR must be auto|always|never (got: $mode); assuming auto"
                  [[ -t 1 ]] && on=1 ;;
  esac
  [[ -n "${NO_COLOR+x}" ]] && on=0
  if (( on )); then
    _caw_c_reset=$'\e[0m'; _caw_c_bold=$'\e[1m';  _caw_c_dim=$'\e[2m'
    _caw_c_red=$'\e[31m';  _caw_c_green=$'\e[32m'; _caw_c_yellow=$'\e[33m'
  else
    _caw_c_reset=""; _caw_c_bold="";  _caw_c_dim=""
    _caw_c_red="";   _caw_c_green=""; _caw_c_yellow=""
  fi
}

_caw_validate_uint() {
  emulate -L zsh
  local name="$1" value="$2"
  if [[ "$value" != <-> ]]; then
    _caw_log ERROR "$name must be a non-negative integer (got: $value)"
    return 2
  fi
}

# ----------------------------------------------------------------------------
# Profile / binary resolution
# ----------------------------------------------------------------------------
# The dir used for the *window check* — always a concrete path (usage endpoint
# needs one). Defaults to ~/.claude even when we let Claude pick its own profile
# for the launch, because that is Claude Code's own default profile too.
_caw_check_dir() {
  local dir="${CLAUDE_AUTO_WINDOW_CONFIG_DIR:-${CLAUDE_CONFIG_DIR:-$HOME/.claude}}"
  print -r -- "${dir%/}"
}

# Whether to pin CLAUDE_CONFIG_DIR for the launch. Only when the operator
# explicitly selected a profile — otherwise we stay a transparent passthrough
# and Claude Code resolves ~/.claude on its own (mirrors claude-profile.zsh).
_caw_launch_profile_pinned() {
  [[ -n "${CLAUDE_AUTO_WINDOW_CONFIG_DIR:-${CLAUDE_CONFIG_DIR:-}}" ]]
}

_caw_resolve_claude_bin() {
  emulate -L zsh
  local configured="${CLAUDE_AUTO_WINDOW_CLAUDE_BIN:-}"
  if [[ -n "$configured" ]]; then
    [[ -x "$configured" ]] && { print -r -- "$configured"; return 0; }
    _caw_log ERROR "CLAUDE_AUTO_WINDOW_CLAUDE_BIN is not executable: $configured"
    return 2
  fi
  local found; found="$(whence -p claude 2>/dev/null)"
  [[ -n "$found" && -x "$found" ]] && { print -r -- "$found"; return 0; }
  local c
  for c in /opt/homebrew/bin/claude "$HOME/.local/bin/claude" \
           "$HOME/.npm-global/bin/claude" /usr/local/bin/claude /usr/bin/claude; do
    [[ -x "$c" ]] && { print -r -- "$c"; return 0; }
  done
  _caw_log ERROR "claude executable not found; set CLAUDE_AUTO_WINDOW_CLAUDE_BIN"
  return 2
}

# ----------------------------------------------------------------------------
# Usage endpoint — self-contained OAuth reader. We only need the raw usage JSON
# for the five-hour window check, so this is deliberately minimal: resolve the
# token Claude Code stored, GET the endpoint, return the raw response. No caching
# / display formatting (that belongs in a standalone `claude-usage` CLI; this is
# a different, programmatic use case).
#
# No Anthropic API key is used — the account's own OAuth login is read from
# <dir>/.credentials.json (Linux) or the macOS Keychain (service
# "Claude Code-credentials-<8 hex of sha256(abs dir)>", plus the legacy
# un-suffixed entry for ~/.claude). The freshest non-expired token wins.
# ----------------------------------------------------------------------------
_caw_resolve_token() {
  emulate -L zsh
  local dir="${1%/}"
  local -a blobs
  blobs=( "$(cat "$dir/.credentials.json" 2>/dev/null)" )
  if command -v security >/dev/null 2>&1; then
    local suffix
    suffix="$(printf '%s' "${dir:a}" | { shasum -a 256 2>/dev/null || sha256sum 2>/dev/null; } | cut -c1-8)"
    [[ -n "$suffix" ]] && blobs+=( "$(security find-generic-password -s "Claude Code-credentials-$suffix" -a "$USER" -w 2>/dev/null)" )
    [[ "$dir" == "$HOME/.claude" ]] && blobs+=( "$(security find-generic-password -s "Claude Code-credentials" -a "$USER" -w 2>/dev/null)" )
  fi
  local token="" best=-1 now_ms=$(( $(date +%s) * 1000 )) blob cand exp expired_only=0
  for blob in "${blobs[@]}"; do
    [[ -z "$blob" ]] && continue
    cand="$(jq -r '.claudeAiOauth.accessToken // empty' <<< "$blob" 2>/dev/null)"
    [[ -z "$cand" ]] && continue
    exp="$(jq -r '.claudeAiOauth.expiresAt // empty' <<< "$blob" 2>/dev/null)"
    [[ -n "$exp" ]] && (( exp <= now_ms )) && { expired_only=1; continue }  # expired
    [[ -z "$exp" ]] && exp=$now_ms                          # unknown expiry: usable, lowest priority
    (( exp > best )) && { best=$exp; token="$cand"; }
  done
  [[ -n "$token" ]] && { print -r -- "$token"; return 0; }
  # 4 = credentials exist but every access token has expired (access tokens live
  # ~8h; only a real claude launch refreshes them, via the stored refresh token).
  # Distinct from 1 (no credentials at all) so callers can fall through to firing
  # the starter — which refreshes the token as a side effect of sending.
  (( expired_only )) && return 4
  return 1
}

# Fresh raw usage JSON for a profile dir. Non-zero (and no output) on any
# failure so callers fall through to "unknown" — except 4 (access token expired,
# see _caw_resolve_token), which is propagated so callers can distinguish
# "can't authenticate until something sends" from network/API errors.
_caw_usage_json() {
  emulate -L zsh
  local dir="$1" token resp rc
  token="$(_caw_resolve_token "$dir")" || { rc=$?; (( rc == 4 )) && return 4; return 3; }
  local code
  resp="$(curl -s -w $'\n__CAW_HTTP__%{http_code}' --connect-timeout 3 --max-time 6 \
    "https://api.anthropic.com/api/oauth/usage" \
    -H "Authorization: Bearer $token" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "Content-Type: application/json" 2>/dev/null)" || return 3
  code="${resp##*__CAW_HTTP__}"
  resp="${resp%$'\n'__CAW_HTTP__*}"
  # 429 is the endpoint throttling us, not a broken account. Distinct rc so the
  # checked paths can hold off instead of concluding "closed" and firing, and so
  # --check can call it transient rather than paging about lost credentials.
  [[ "$code" == 429 ]] && return 5
  # Validate it's a real usage response, not an error/HTML/empty body.
  jq -e 'type == "object" and (.error == null) and ((.limits != null) or (.five_hour != null))' \
    <<< "$resp" >/dev/null 2>&1 || return 3
  print -r -- "$resp"
}

# Is a five-hour window currently open?
#   0 = open, 1 = closed, 2 = account has NO 5h window (API/usage-billed seat —
#   nothing to keep open), 3 = could not determine (network/API error),
#   4 = access token expired — state is unknowable until a claude launch
#   refreshes it, and the starter itself does exactly that, so callers should
#   treat this as "proceed to fire", not as an error. (This 4 is internal to
#   the session-check path; it is unrelated to the public exit code 4 =
#   "starter sent but no reply" from _caw_send_starter.)
#
# "Open" is decided SOLELY by `resets_at` being in the FUTURE. We deliberately do
# NOT consult the endpoint's `is_active` flag: it tracks *recent activity* (reads
# false on an open-but-idle window) and adds no coverage resets_at doesn't already
# give — and worse, a lingering `is_active` on a *past* resets_at could falsely
# read "open". resets_at is the one signal.
# On a confirmed-open return (0), this records profile + resets_at in the
# per-profile state file. That stored resets_at is the single source of truth for
# "when to act next": both the --once early-exit and the daemon's sleep read it.
# (It also self-documents which subscription the opaque <hash>.state belongs to.)
# Decide open/closed from already-fetched usage JSON, recording resets_at under
# a given STATE KEY on a confirmed-open. Same return codes as _caw_session_active
# minus 4 (no token concept here — the caller fetched the JSON):
#   0 open (records resets_at), 1 closed, 2 no session window, 3 unparseable.
# $1 = state key (a dir for dir-targets, or an account pseudo-key), $2 = usage
# JSON, $3 = profile label to record (optional; defaults to the key).
_caw_session_from_json() {
  emulate -L zsh
  local key="$1" json="$2" label="${3:-$1}" has sess resets now
  [[ -n "$json" ]] || return 3
  # Does this account use the 5-hour session-window model at all? Pro/Max do;
  # API/usage-billed (Team/Enterprise/console) seats return no session limit.
  has="$(jq '[.limits[]? | select(.kind=="session")] | length' <<< "$json" 2>/dev/null)"
  [[ "$has" == <-> ]] || return 3
  (( has == 0 )) && return 2
  sess="$(jq -c 'first(.limits[]? | select(.kind=="session")) // {}' <<< "$json" 2>/dev/null)"
  resets="$(jq -r '.resets_at // ""' <<< "$sess" 2>/dev/null)"
  [[ -n "$resets" && "$resets" != "null" ]] || return 1   # no reset time → closed
  # resets_at and `date -u` are both UTC ISO-8601, so a lexical compare of the
  # fixed-width YYYY-MM-DDTHH:MM:SS prefix is a correct chronological compare.
  now="$(date -u +%Y-%m-%dT%H:%M:%S)"
  if [[ "${resets:0:19}" > "$now" ]]; then                # future → open
    _caw_state_set "$key" profile "$label"
    _caw_state_set "$key" resets_at "$resets"
    return 0
  fi
  return 1                                                # null / past → closed
}

_caw_session_active() {
  emulate -L zsh
  local dir="$1" json rc
  json="$(_caw_usage_json "$dir")" || { rc=$?; (( rc == 4 || rc == 5 )) && return $rc; return 3; }
  _caw_session_from_json "$dir" "$json" "$dir"
}

# Convert a UTC ISO-8601 timestamp (e.g. 2026-07-19T06:40:00.351+00:00) to epoch
# seconds. Tries BSD (macOS) then GNU (Linux) date. Non-zero if unparseable.
_caw_iso_to_epoch() {
  emulate -L zsh
  local dt="${1:0:19}" e                                  # YYYY-MM-DDTHH:MM:SS, UTC
  [[ -n "$dt" ]] || return 1
  e="$(date -u -j -f "%Y-%m-%dT%H:%M:%S" "$dt" +%s 2>/dev/null)" && { print -r -- "$e"; return 0; }
  e="$(date -u -d "${dt}Z" +%s 2>/dev/null)" && { print -r -- "$e"; return 0; }
  return 1
}

# Print a human status line.
_caw_status_line() {
  emulate -L zsh
  local dir="$1" rc json session open pct reset
  _caw_session_active "$dir"; rc=$?
  if (( rc == 3 )); then
    _caw_log ERROR "usage lookup failed for $dir"; return 1
  elif (( rc == 4 )); then
    print -r -- "profile=${_caw_c_bold}${dir}${_caw_c_reset} five_hour=${_caw_c_yellow}?${_caw_c_reset} ${_caw_c_dim}(access token expired — --once/the daemon self-heal it with a bare claude launch; any claude use also refreshes it)${_caw_c_reset}"
    return 0
  elif (( rc == 5 )); then
    print -r -- "profile=${_caw_c_bold}${dir}${_caw_c_reset} five_hour=${_caw_c_yellow}?${_caw_c_reset} ${_caw_c_dim}(usage endpoint rate-limiting us — HTTP 429, transient)${_caw_c_reset}"
    return 0
  elif (( rc == 2 )); then
    print -r -- "profile=${_caw_c_bold}${dir}${_caw_c_reset} five_hour=${_caw_c_yellow}n/a${_caw_c_reset} ${_caw_c_dim}(no session window — API/usage-billed account?)${_caw_c_reset}"
    return 0
  fi
  (( rc == 0 )) && open=yes || open=no
  json="$(_caw_usage_json "$dir")"
  session="$(jq -c 'first(.limits[]? | select(.kind=="session")) // {}' <<< "$json" 2>/dev/null)"
  pct="$(jq -r '.percent // 0'       <<< "$session")"
  reset="$(jq -r '.resets_at // "?"' <<< "$session")"
  local c_open; [[ "$open" == yes ]] && c_open="$_caw_c_green" || c_open="$_caw_c_yellow"
  print -r -- "profile=${_caw_c_bold}${dir}${_caw_c_reset} five_hour_open=${c_open}${open}${_caw_c_reset} percent=$pct resets_at=${_caw_c_dim}${reset}${_caw_c_reset}"

  # Balance-gate view — what the daemon will ACTUALLY do next, and why. The
  # starter's own model decides which weekly bucket governs it (see
  # _caw_plan_exhausted); this is the single most useful line when eyeballing
  # whether the daemon is keeping a window open or standing down to spare credits.
  local model="${CLAUDE_AUTO_WINDOW_MODEL-haiku}" wpct verdict
  wpct="$(jq -r 'first(.limits[]? | select(.kind=="weekly_all")) | .percent // "?"' <<< "$json" 2>/dev/null)"
  if _caw_plan_exhausted "$json" "$model"; then
    verdict="${_caw_c_yellow}WOULD SKIP${_caw_c_reset} — starter model '${model:-<account default>}' is off-plan (credit-billed / refused)"
  else
    verdict="${_caw_c_green}would fire${_caw_c_reset} — starter model '${model:-<account default>}' still on plan"
  fi
  print -r -- "  weekly_all=${wpct}%  →  $verdict"

  # Credits (extra_usage), if the account has them — these are only spent once a
  # plan bucket is exhausted, so a non-zero balance here is NOT proof of spend.
  local credit_line
  credit_line="$(jq -r '
      (.extra_usage // {}) as $e |
      if ($e.is_enabled // false) then
        (pow(10; ($e.decimal_places // 2))) as $d |
        ((($e.used_credits  // 0)/$d*100)|round/100) as $used |
        ((($e.monthly_limit // 0)/$d*100)|round/100) as $lim  |
        "  credits=\($used)/\($lim) \($e.currency // "") used (\(($e.utilization // 0)|floor)%) — spent only after plan is exhausted"
      else empty end' <<< "$json" 2>/dev/null)"
  [[ -n "$credit_line" ]] && print -r -- "${_caw_c_dim}${credit_line}${_caw_c_reset}"

  # Daemon's own source of truth: the stored resets_at it sleeps against (can lag
  # the live endpoint by a few minutes right after a fresh open).
  local ssr; ssr="$(_caw_state_get "$dir" resets_at 2>/dev/null)"
  [[ -n "$ssr" && "$ssr" != "$reset" ]] && print -r -- "${_caw_c_dim}  daemon-stored resets_at=$ssr${_caw_c_reset}"

  if _caw_breaker_tripped "$dir"; then
    print -r -- "  ${_caw_c_red}${_caw_c_bold}⚠ DISABLED (sentinel present):${_caw_c_reset} $(_caw_state_file "$dir" tripped)"
    print -r -- "${_caw_c_dim}    reason: $(_caw_breaker_reason "$dir")${_caw_c_reset}"
    print -r -- "${_caw_c_dim}    re-enable: claude-auto-window --reset${_caw_c_reset}"
  fi
}

# Clear a tripped circuit breaker (and the failure counter) for the CURRENTLY
# pinned profile, so the daemon/cron will resume opening its window. Single-
# profile body; the public claude-auto-window-reset iterates it over all specs.
_caw_reset_one() {
  emulate -L zsh
  [[ -n "${CLAUDE_AUTO_WINDOW_CP_ACCOUNT:-}" ]] && { _caw_reset_account; return $?; }
  local dir; dir="$(_caw_check_dir)"
  if _caw_breaker_tripped "$dir"; then
    _caw_breaker_clear "$dir"
    _caw_log INFO "Circuit breaker cleared for $dir — will resume on the next run"
  else
    _caw_breaker_clear "$dir"     # also clears any lingering counter
    _caw_log INFO "No tripped breaker for $dir; cleared any failure counter"
  fi
}

# Would firing a starter now draw from purchased usage credits instead of the
# plan (or fail to send at all)? This is the "balance gate": the whole point of
# holding a window open is to soak up PLAN allowance you'd otherwise waste — if
# the plan is exhausted, the starter either can't send (rate-limited → no reply)
# or spends real credits, and the window is worthless anyway (no plan allowance
# left to use inside it). Either way: don't open it.
#
# Credits only cover a request once the PLAN limit governing THAT request is
# exhausted (the endpoint's own words: "Usage credits cover you when you hit your
# plan limits"). The starter is one tiny request on $model, fired only when the
# 5-hour window is closed (so the session cap is fresh) — hence the governing
# plan limit is the overall weekly cap `weekly_all`, PLUS any model-scoped weekly
# cap (`weekly_scoped`) whose scope matches $model. A scoped cap for a DIFFERENT
# model (e.g. Fable maxed while the starter is haiku) is that model's bucket and
# must NOT block us — anchoring on haiku there is still plan-covered and free.
#
# "Exhausted" = percent >= CLAUDE_AUTO_WINDOW_WEEKLY_MAX_PERCENT (default 100; set
# it lower, e.g. 97, for a safety margin against edge-of-limit credit bleed) OR
# severity "exceeded". Returns 0 = exhausted (skip the starter), non-zero = still
# on plan (fire away).
_caw_plan_exhausted() {
  emulate -L zsh
  local json="$1" model="${2:-}"
  local max="${CLAUDE_AUTO_WINDOW_WEEKLY_MAX_PERCENT:-100}"
  _caw_validate_uint CLAUDE_AUTO_WINDOW_WEEKLY_MAX_PERCENT "$max" || max=100
  # Model-scope match is fuzzy on purpose: scoped caps carry a display_name
  # ("Fable", "Sonnet", …) while $model is usually an alias ("haiku", "sonnet").
  # A case-insensitive substring match either way pairs "sonnet" with "Sonnet"
  # without pairing "haiku" with "Fable". Empty $model (account-default starter)
  # ⇒ we can't scope-match, so only weekly_all governs — the safe choice.
  jq -e --argjson max "$max" --arg model "${model:l}" '
      def exhausted: ((.percent // 0) >= $max) or ((.severity // "normal") == "exceeded");
      any(.limits[]?;
        (.kind == "weekly_all" and exhausted)
        or (.kind == "weekly_scoped" and exhausted and ($model != "")
            and (((.scope.model.display_name // "") | ascii_downcase) as $dn
                 | $dn != "" and (($model | contains($dn)) or ($dn | contains($model))))))' \
    <<< "$json" >/dev/null 2>&1
}

# Random integer in [0, max], preferring /dev/urandom, falling back to $RANDOM.
_caw_random() {
  emulate -L zsh
  local max="$1"
  (( max > 0 )) || { print 0; return; }
  local n=""
  if [[ -r /dev/urandom ]] && command -v od >/dev/null 2>&1; then
    n="$(od -An -N4 -tu4 /dev/urandom 2>/dev/null | tr -d '[:space:]')"
  fi
  [[ "$n" == <-> ]] || n="$RANDOM"
  print $(( n % (max + 1) ))
}

# Generate a lowercase UUID for --session-id (Linux /proc first, uuidgen else).
_caw_uuid() {
  emulate -L zsh
  local u=""
  if [[ -r /proc/sys/kernel/random/uuid ]]; then
    u="$(</proc/sys/kernel/random/uuid)"
  elif command -v uuidgen >/dev/null 2>&1; then
    u="$(uuidgen)"
  fi
  print -r -- "${u:l}"
}

# Delete the starter's own conversation transcript so it doesn't clutter the
# log. We pin a known session id, so the file is exactly <uuid>.jsonl under the
# active profile's projects/ tree (opt out with CLAUDE_AUTO_WINDOW_KEEP_TRANSCRIPT=1).
_caw_cleanup_transcript() {
  emulate -L zsh
  setopt local_options extended_glob null_glob
  local dir="$1" uuid="$2"
  [[ "${CLAUDE_AUTO_WINDOW_KEEP_TRANSCRIPT:-0}" == 1 ]] && return 0
  [[ -n "$uuid" && -d "$dir/projects" ]] || return 0
  local -a hits
  hits=( "$dir"/projects/**/"$uuid".jsonl )
  if (( ${#hits} )); then
    rm -f -- "${hits[@]}" 2>/dev/null
    _caw_log INFO "Removed starter transcript (${uuid}.jsonl)"
  fi
}

# ----------------------------------------------------------------------------
# Per-profile process lock — never run two starters for the same profile at once.
# ----------------------------------------------------------------------------
_caw_lock_path() {
  emulate -L zsh
  local dir="$1" suffix
  suffix="$(printf '%s' "${dir:a}" \
    | { shasum -a 256 2>/dev/null || sha256sum 2>/dev/null; } | cut -c1-8)"
  [[ -n "$suffix" ]] || suffix="default"
  print -r -- "${TMPDIR:-/tmp}/claude-auto-window.${suffix}.lock"
}

# Returns 0 (prints lock path) or 75 if another live process owns it.
_caw_acquire_lock() {
  emulate -L zsh
  local dir="$1" lock owner
  lock="$(_caw_lock_path "$dir")"
  if ! mkdir "$lock" 2>/dev/null; then
    [[ -r "$lock/pid" ]] && owner="$(<"$lock/pid")"
    if [[ "$owner" == <-> ]] && kill -0 "$owner" 2>/dev/null; then
      return 75
    fi
    rm -rf "$lock" 2>/dev/null
    mkdir "$lock" 2>/dev/null || return 75
  fi
  print -r -- "$$" > "$lock/pid"
  print -r -- "$lock"
}

_caw_release_lock() {
  emulate -L zsh
  [[ -n "$1" ]] && rm -rf "$1" 2>/dev/null
}

# ----------------------------------------------------------------------------
# Config & state locations (XDG):
#   config  ${XDG_CONFIG_HOME:-~/.config}/claude-auto-window/  — settings you set
#   state   ${XDG_STATE_HOME:-~/.local/state}/claude-auto-window/ — data we write
# A per-profile <hash>.state file (key=value) holds the failure counter and the
# open-timing; the disable sentinel (<hash>.tripped) is its own file so
# "present = disabled" stays a trivial touch/rm kill-switch. The process lock
# stays a transient tmp mkdir-lock (see _caw_lock_path).
# ----------------------------------------------------------------------------
_caw_config_dir() {
  emulate -L zsh
  print -r -- "${XDG_CONFIG_HOME:-$HOME/.config}/claude-auto-window"
}

# Auto-load a config file (cron/manual convenience) so settings need not be
# repeated as flags. Only fills CLAUDE_AUTO_WINDOW_* vars NOT already set, so the
# environment (systemd EnvironmentFile) and CLI flags still win. Values are
# literal, like a systemd EnvironmentFile — no shell quoting.
_caw_load_config() {
  emulate -L zsh
  local f="${CLAUDE_AUTO_WINDOW_CONFIG:-$(_caw_config_dir)/config}"
  [[ -r "$f" ]] || return 0
  local line key val
  while IFS= read -r line; do
    [[ -z "${line//[[:space:]]/}" || "${line##[[:space:]]#}" == \#* ]] && continue
    [[ "$line" == *=* ]] || continue
    key="${line%%=*}"; key="${key//[[:space:]]/}"
    [[ "$key" == CLAUDE_AUTO_WINDOW_* ]] || continue
    [[ -n "${(P)key+x}" ]] && continue          # already set by env/flags → keep it
    val="${line#*=}"
    typeset -gx "$key=$val"
  done < "$f"
}

_caw_state_dir() {
  emulate -L zsh
  print -r -- "${CLAUDE_AUTO_WINDOW_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/claude-auto-window}"
}

_caw_state_file() {   # $1 = config dir, $2 = short name (state | tripped)
  emulate -L zsh
  local dir="$1" name="$2" suffix
  suffix="$(printf '%s' "${dir:a}" | { shasum -a 256 2>/dev/null || sha256sum 2>/dev/null; } | cut -c1-8)"
  [[ -n "$suffix" ]] || suffix="default"
  print -r -- "$(_caw_state_dir)/${suffix}.${name}"
}

# key=value store in <hash>.state --------------------------------------------
_caw_state_get() {   # $1 = dir, $2 = key → prints value, non-zero if absent
  emulate -L zsh
  local f key="$2" line; f="$(_caw_state_file "$1" state)"
  [[ -r "$f" ]] || return 1
  while IFS= read -r line; do
    [[ "$line" == "$key="* ]] && { print -r -- "${line#*=}"; return 0; }
  done < "$f"
  return 1
}

_caw_state_set() {   # $1 = dir, $2 = key, $3 = value (atomic rewrite)
  emulate -L zsh
  local f key="$2" val="$3" tmp line found=0; f="$(_caw_state_file "$1" state)"
  mkdir -p "${f:h}" 2>/dev/null
  tmp="$f.tmp.$$"
  {
    [[ -r "$f" ]] && while IFS= read -r line; do
      if [[ "$line" == "$key="* ]]; then print -r -- "$key=$val"; found=1
      else print -r -- "$line"; fi
    done < "$f"
    (( found )) || print -r -- "$key=$val"
  } > "$tmp" 2>/dev/null && mv "$tmp" "$f" 2>/dev/null
}

_caw_state_del() {   # $1 = dir, $2 = key
  emulate -L zsh
  local f key="$2" tmp line; f="$(_caw_state_file "$1" state)"
  [[ -r "$f" ]] || return 0
  tmp="$f.tmp.$$"
  { while IFS= read -r line; do [[ "$line" == "$key="* ]] || print -r -- "$line"; done < "$f"; } \
    > "$tmp" 2>/dev/null && mv "$tmp" "$f" 2>/dev/null
}

# ----------------------------------------------------------------------------
# Post-open cooldown — the usage endpoint takes a few minutes to reflect a
# freshly opened window; during that lag _caw_session_active still reads
# "closed". We stamp last_open on every successful open and suppress re-firing
# for CLAUDE_AUTO_WINDOW_OPEN_COOLDOWN_SECONDS (default 900) so the daemon/cron
# doesn't fire a redundant starter while the endpoint catches up.
# ----------------------------------------------------------------------------
_caw_mark_opened() {
  emulate -L zsh
  _caw_state_set "$1" last_open "$(date +%s)"
}

_caw_recently_opened() {   # 0 if we opened a window within the cooldown
  emulate -L zsh
  local dir="$1" cooldown="${CLAUDE_AUTO_WINDOW_OPEN_COOLDOWN_SECONDS:-900}" t
  _caw_validate_uint CLAUDE_AUTO_WINDOW_OPEN_COOLDOWN_SECONDS "$cooldown" || return 1
  t="$(_caw_state_get "$dir" last_open)" || return 1
  [[ "$t" == <-> ]] || return 1
  (( $(date +%s) - t < cooldown ))
}

# ----------------------------------------------------------------------------
# Circuit breaker — stop an endless loop. Count consecutive opens that never
# register a window; after CLAUDE_AUTO_WINDOW_MAX_FAILURES (default 3) TRIP:
# notify + write the sentinel + refuse to run until --reset. The counter (in the
# state file) resets whenever a window is confirmed open. The sentinel is its own
# durable file so a cron job no-ops and a restarted daemon stays stopped.
# ----------------------------------------------------------------------------
_caw_breaker_count() {
  emulate -L zsh
  local n; n="$(_caw_state_get "$1" failcount)"; [[ "$n" == <-> ]] || n=0
  print -r -- "$n"
}

_caw_breaker_inc() {
  emulate -L zsh
  local n=$(( $(_caw_breaker_count "$1") + 1 ))
  _caw_state_set "$1" failcount "$n"
  print -r -- "$n"
}

_caw_breaker_reset() {   # window healthy → clear the counter
  emulate -L zsh
  _caw_state_del "$1" failcount
}

_caw_breaker_trip() {    # $2 = reason
  emulate -L zsh
  local f; f="$(_caw_state_file "$1" tripped)"
  mkdir -p "${f:h}" 2>/dev/null
  print -r -- "$(date '+%Y-%m-%d %H:%M:%S') $2" > "$f" 2>/dev/null
}

_caw_breaker_tripped() { emulate -L zsh; [[ -e "$(_caw_state_file "$1" tripped)" ]]; }
_caw_breaker_reason()  { emulate -L zsh; local f; f="$(_caw_state_file "$1" tripped)"; [[ -r "$f" ]] && cat "$f" 2>/dev/null; }
_caw_breaker_clear()   { emulate -L zsh; rm -f "$(_caw_state_file "$1" tripped)" 2>/dev/null; _caw_state_del "$1" failcount; }

# Fire an operator notification, if a hook command is configured. The message is
# passed both on stdin and as $CLAUDE_AUTO_WINDOW_MESSAGE, so hooks can use either
# (mail/ntfy read stdin; notify-send/osascript reference the env var).
_caw_notify() {
  emulate -L zsh
  local msg="$1"
  [[ -n "${CLAUDE_AUTO_WINDOW_NOTIFY_CMD:-}" ]] || return 0
  print -r -- "$msg" | CLAUDE_AUTO_WINDOW_MESSAGE="$msg" sh -c "$CLAUDE_AUTO_WINDOW_NOTIFY_CMD" 2>/dev/null
}

# ----------------------------------------------------------------------------
# The core: drive a real interactive Claude session inside a throwaway tmux
# session, wait for the reply, quit cleanly, tear it down.
# ----------------------------------------------------------------------------
# Wait until the expected reply token appears at least $count times in the pane.
# The prompt itself is echoed in Claude's input box, so it contributes one
# occurrence; the reply contributes another — hence the default threshold of 2.
#
# Also self-bootstraps the workspace-trust dialog: an interactive TTY (which a
# tmux pane is) shows "Do you trust the files in this folder?" on the first run
# in a new dir. We accept it by sending Enter (option 1, "Yes, proceed", is the
# highlighted default). Safe here because the starter dir is a dedicated empty
# directory the operator owns — override the keys with CLAUDE_AUTO_WINDOW_TRUST_KEYS.
_caw_wait_reply() {
  emulate -L zsh
  local sock="$1" sess="$2" timeout="$3" expect="$4" prompt="$5" count="${6:-1}"
  local deadline=$(( $(date +%s) + timeout )) pane body n trusted=0
  local -a trust_keys=( ${=CLAUDE_AUTO_WINDOW_TRUST_KEYS:-Enter} )

  # The prompt text (everything up to the expected token) is echoed in the input
  # box / rendered as the user turn — and it contains the expected token itself
  # (e.g. "…: OK."). Filter those lines out so we only match Claude's own reply.
  local prefix="${prompt%%${expect}*}"

  while (( $(date +%s) < deadline )); do
    # Session gone unexpectedly (crash / early exit) → give up.
    tmux -L "$sock" has-session -t "$sess" 2>/dev/null || return 2
    pane="$(tmux -L "$sock" capture-pane -p -t "$sess" 2>/dev/null)"

    # Accept the trust dialog once, if it appears (first run in a new dir).
    if (( ! trusted )) && \
       print -r -- "$pane" | grep -qiE 'trust the files in this folder|Do you trust|Yes, (proceed|I trust)' 2>/dev/null; then
      _caw_log INFO "Accepting workspace-trust dialog for the starter dir"
      tmux -L "$sock" send-keys -t "$sess" "${trust_keys[@]}" 2>/dev/null
      trusted=1
      sleep 1
      continue
    fi

    # Count the expected token only in lines that are NOT the prompt echo.
    if [[ -n "$prefix" ]]; then
      body="$(print -r -- "$pane" | grep -vF -- "$prefix" 2>/dev/null)"
    else
      body="$pane"
    fi
    n="$(print -r -- "$body" | grep -F -c -- "$expect" 2>/dev/null)"
    [[ "$n" == <-> ]] || n=0
    (( n >= count )) && return 0
    sleep 2
  done
  return 1
}

# Quit Claude gracefully (/exit), fall back to Ctrl-C, then kill the session.
_caw_quit_and_kill() {
  emulate -L zsh
  local sock="$1" sess="$2" i cur
  tmux -L "$sock" send-keys -t "$sess" -- "/exit" Enter 2>/dev/null
  for i in {1..8}; do
    sleep 1
    tmux -L "$sock" has-session -t "$sess" 2>/dev/null || return 0   # already gone
    cur="$(tmux -L "$sock" display-message -p -t "$sess" '#{pane_current_command}' 2>/dev/null)"
    case "$cur" in
      *zsh|*bash|*sh|-zsh|-bash) break ;;   # back to a shell → claude has exited
    esac
    (( i == 3 )) && tmux -L "$sock" send-keys -t "$sess" C-c C-c 2>/dev/null
  done
  tmux -L "$sock" kill-session -t "$sess" 2>/dev/null
}

# Self-heal an expired access token WITHOUT spending anything: launch a bare
# interactive claude in the same throwaway tmux — with NO prompt argument, so
# nothing is ever sent, no 5-hour window is opened, and no usage is spent — and
# wait for the stored credential to turn fresh. The CLI refreshes the access
# token (via the stored refresh token) on its first authenticated backend call
# at startup, typically within seconds; verified empirically 2026-07-20 (see
# AGENTS.md → Gotchas). Then tear the session down like a normal starter.
#   0 = token is fresh now, non-zero = it never turned fresh (most likely the
#   refresh token has expired too — >~3 days idle — which needs a manual login).
_caw_refresh_token() {
  emulate -L zsh
  local dir="$1" claude_bin starter_dir sock sess uuid pane
  local timeout="${CLAUDE_AUTO_WINDOW_REFRESH_TIMEOUT_SECONDS:-45}"
  _caw_validate_uint CLAUDE_AUTO_WINDOW_REFRESH_TIMEOUT_SECONDS "$timeout" || return $?
  claude_bin="$(_caw_resolve_claude_bin)" || return $?
  command -v tmux >/dev/null 2>&1 || { _caw_log ERROR "tmux not found on PATH"; return 2; }

  # Same stable starter dir + isolated socket as _caw_send_starter (one trust
  # entry, never the user's real tmux server).
  starter_dir="${CLAUDE_AUTO_WINDOW_STARTER_DIR:-${${TMPDIR:-/tmp}%/}/claude-auto-window-${UID}}"
  sock="${CLAUDE_AUTO_WINDOW_TMUX_SOCKET:-claude-auto-window}"
  mkdir -p "$starter_dir" || { _caw_log ERROR "cannot create starter dir: $starter_dir"; return 1; }
  sess="caw-refresh-$$-$(date +%s)-${RANDOM}"
  uuid="$(_caw_uuid)"

  # Same launch shape as the starter (API-key strip, profile pinning, LIGHT
  # context stripping, pinned session id) — minus the prompt and the model:
  # with nothing to send, there is nothing to bill and no model to pick.
  local -a launch
  launch=( env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_SKIP_PROMPT_HISTORY=1 )
  _caw_launch_profile_pinned && launch+=( "CLAUDE_CONFIG_DIR=$dir" )
  launch+=( "$claude_bin" )
  if [[ "${CLAUDE_AUTO_WINDOW_LIGHT:-1}" == 1 ]]; then
    launch+=( --safe-mode --tools "" --exclude-dynamic-system-prompt-sections )
  fi
  [[ -n "$uuid" ]] && launch+=( --session-id "$uuid" )
  local paneline="cd ${(q)starter_dir} && exec ${(j: :)${(@q)launch}}"

  _caw_log INFO "Token refresh: launching a bare claude session '$sess' (no prompt — nothing is sent or spent)"
  if ! tmux -L "$sock" new-session -d -s "$sess" -x 220 -y 50 "$paneline" 2>/dev/null; then
    _caw_log ERROR "failed to create tmux session"
    return 1
  fi

  {
    local deadline=$(( $(date +%s) + timeout )) trusted=0
    local -a trust_keys=( ${=CLAUDE_AUTO_WINDOW_TRUST_KEYS:-Enter} )
    while (( $(date +%s) < deadline )); do
      if _caw_resolve_token "$dir" >/dev/null; then
        _caw_log INFO "Access token refreshed by the launch"
        return 0
      fi
      tmux -L "$sock" has-session -t "$sess" 2>/dev/null || break   # crash/early exit
      # First run in a new starter dir: accept the trust dialog, same as the starter.
      if (( ! trusted )); then
        pane="$(tmux -L "$sock" capture-pane -p -t "$sess" 2>/dev/null)"
        if print -r -- "$pane" | grep -qiE 'trust the files in this folder|Do you trust|Yes, (proceed|I trust)' 2>/dev/null; then
          _caw_log INFO "Accepting workspace-trust dialog for the starter dir"
          tmux -L "$sock" send-keys -t "$sess" "${trust_keys[@]}" 2>/dev/null
          trusted=1
        fi
      fi
      sleep 2
    done
    _caw_log WARN "token did not refresh within ${timeout}s — the refresh token has likely expired too (>~3 days without Claude activity); a manual claude session / login is needed"
    return 1
  } always {
    _caw_quit_and_kill "$sock" "$sess"
    _caw_cleanup_transcript "$dir" "$uuid"
  }
}

# Send exactly one interactive starter.
#   $1 = check dir, $2 = show output (1/0), $3 = model (optional; "" = account
#   default / no --model). When $3 is omitted, CLAUDE_AUTO_WINDOW_MODEL is used
#   (default: the "haiku" alias — cheapest tier, always the latest version).
_caw_send_starter() {
  emulate -L zsh
  local dir="$1" show="${2:-0}" model
  if (( $# >= 3 )); then model="$3"; else model="${CLAUDE_AUTO_WINDOW_MODEL-haiku}"; fi
  local claude_bin prompt starter_dir sock sess expect count reply_timeout
  claude_bin="$(_caw_resolve_claude_bin)" || return $?

  command -v tmux >/dev/null 2>&1 || { _caw_log ERROR "tmux not found on PATH"; return 2; }

  prompt="${CLAUDE_AUTO_WINDOW_PROMPT:-Reply with exactly: OK.}"
  # Default to a stable per-user tmp dir: isolated from the work cwd, always
  # empty (transcripts are cleaned), and trusted exactly once — so it adds a
  # single ~/.claude.json trust entry, not one per run. Re-trusted automatically
  # if a reboot clears tmp. Override with --starter-dir for a fixed location.
  starter_dir="${CLAUDE_AUTO_WINDOW_STARTER_DIR:-${${TMPDIR:-/tmp}%/}/claude-auto-window-${UID}}"
  sock="${CLAUDE_AUTO_WINDOW_TMUX_SOCKET:-claude-auto-window}"
  expect="${CLAUDE_AUTO_WINDOW_EXPECT:-OK.}"
  count="${CLAUDE_AUTO_WINDOW_EXPECT_COUNT:-1}"   # prompt echo is filtered out
  reply_timeout="${CLAUDE_AUTO_WINDOW_REPLY_TIMEOUT_SECONDS:-120}"
  _caw_validate_uint CLAUDE_AUTO_WINDOW_EXPECT_COUNT "$count" || return $?
  _caw_validate_uint CLAUDE_AUTO_WINDOW_REPLY_TIMEOUT_SECONDS "$reply_timeout" || return $?

  mkdir -p "$starter_dir" || { _caw_log ERROR "cannot create starter dir: $starter_dir"; return 1; }

  # Unique tmux session name + a pinned session id we can delete afterward.
  sess="caw-$$-$(date +%s)-${RANDOM}"
  local uuid; uuid="$(_caw_uuid)"

  # Build the command line that runs inside the pane. Strip any API-key env so
  # the subscription OAuth login is used (an API key would bill separately and
  # not anchor the subscription window); skip prompt history. Pin the profile
  # only when explicitly selected.
  local -a launch
  launch=( env -u ANTHROPIC_API_KEY -u ANTHROPIC_AUTH_TOKEN CLAUDE_CODE_SKIP_PROMPT_HISTORY=1 )
  _caw_launch_profile_pinned && launch+=( "CLAUDE_CONFIG_DIR=$dir" )
  launch+=( "$claude_bin" )

  # Lightest possible context (opt out with CLAUDE_AUTO_WINDOW_LIGHT=0):
  #   --safe-mode   strip CLAUDE.md/memory, skills, hooks, MCP, plugins, agents,
  #                 output styles, themes, keybindings — OAuth auth still works.
  #   --tools ""    no built-in tool schemas in the context.
  #   --exclude-dynamic-system-prompt-sections  trim per-machine prompt sections.
  if [[ "${CLAUDE_AUTO_WINDOW_LIGHT:-1}" == 1 ]]; then
    launch+=( --safe-mode --tools "" --exclude-dynamic-system-prompt-sections )
  fi
  [[ -n "$uuid" ]] && launch+=( --session-id "$uuid" )
  [[ -n "$model" ]] && launch+=( --model "$model" )
  launch+=( "$prompt" )

  # Run claude directly as the pane's process (tmux execs it via `sh -c`) rather
  # than typing it into an interactive shell. That avoids a shell command-echo
  # in the pane — which would contain the prompt text ("…OK.") and defeat reply
  # detection. `exec` makes claude the pane's foreground process.
  local paneline="cd ${(q)starter_dir} && exec ${(j: :)${(@q)launch}}"

  _caw_log INFO "Opening tmux starter session '$sess' (socket '$sock', model '${model:-<account default>}')"
  if ! tmux -L "$sock" new-session -d -s "$sess" -x 220 -y 50 "$paneline" 2>/dev/null; then
    _caw_log ERROR "failed to create tmux session"
    return 1
  fi

  {
    if _caw_wait_reply "$sock" "$sess" "$reply_timeout" "$expect" "$prompt" "$count"; then
      _caw_log INFO "Claude replied ('$expect' x$count seen); closing session"
      (( show )) && tmux -L "$sock" capture-pane -p -t "$sess" 2>/dev/null
    else
      _caw_log WARN "no reply within ${reply_timeout}s (auth issue or a blocking prompt?)"
      (( show )) && tmux -L "$sock" capture-pane -p -t "$sess" 2>/dev/null
      return 4     # teardown happens in the always block below
    fi
  } always {
    _caw_quit_and_kill "$sock" "$sess"
    _caw_cleanup_transcript "$dir" "$uuid"
  }
  return 0
}

# ----------------------------------------------------------------------------
# Strategy: HTTP (spoof) — anchor a window with ONE raw POST /v1/messages using
# the OAuth token Claude Code already stored, no tmux and no claude binary.
#
# The subscription OAuth token is only accepted on /v1/messages when the request
# presents as Claude Code: the `anthropic-beta: oauth-2025-04-20` header AND a
# system prompt whose first block is EXACTLY the Claude Code identity string.
# Without both, the backend rejects the token (401/403). A completed request is
# exactly what anchors a fresh 5-hour window — same as the tmux starter's send,
# minus the terminal. Validated live 2026-07-27.
#
# Signature mirrors _caw_send_starter: $1 = check dir, $2 = show output (1/0),
# $3 = model (a CONCRETE API model id — the CLI's "haiku" alias is not valid on
# the API). Return codes:
#   0 = request completed → window anchored
#   4 = sent but no usable completion / network error (breaker-countable, like
#       the tmux no-reply)
#   5 = cannot proceed over HTTP (no/expired token, or auth rejected) → caller
#       should fall back to the tmux opener, which self-heals the token and sends
#   6 = the model id was rejected (retired/unknown) → caller retries / falls back
#   2 = config error (missing curl/jq, bad max-tokens)
# The access token is resolved into a local and NEVER logged.
# ----------------------------------------------------------------------------
_caw_send_starter_http() {
  emulate -L zsh
  local dir="$1" show="${2:-0}" model="$3"
  local rc token prompt sys body resp code json text stop err maxtok
  command -v curl >/dev/null 2>&1 || { _caw_log ERROR "curl not found on PATH"; return 2; }
  command -v jq   >/dev/null 2>&1 || { _caw_log ERROR "jq not found on PATH"; return 2; }

  token="$(_caw_resolve_token "$dir")"; rc=$?
  if (( rc != 0 )); then
    # 4 = every stored access token expired; 1/other = none at all. Either way
    # HTTP can't authenticate — defer to the tmux opener (a real claude launch is
    # the only thing that refreshes the token, and its send also anchors).
    _caw_log INFO "HTTP opener: no usable access token (resolve rc $rc) — deferring to tmux opener"
    return 5
  fi

  prompt="${CLAUDE_AUTO_WINDOW_PROMPT:-Reply with exactly: OK.}"
  maxtok="${CLAUDE_AUTO_WINDOW_HTTP_MAX_TOKENS:-16}"
  _caw_validate_uint CLAUDE_AUTO_WINDOW_HTTP_MAX_TOKENS "$maxtok" || return 2
  # system[0] MUST be exactly this — it is the load-bearing half of the OAuth
  # acceptance contract (the beta header is the other half).
  sys="You are Claude Code, Anthropic's official CLI for Claude."
  body="$(jq -n --arg m "$model" --arg s "$sys" --arg p "$prompt" --argjson mt "$maxtok" '{
    model: $m, max_tokens: $mt,
    system: [ { type: "text", text: $s } ],
    messages: [ { role: "user", content: $p } ]
  }')" || { _caw_log ERROR "HTTP opener: failed to build request body"; return 2; }

  _caw_log INFO "HTTP opener: POST /v1/messages (model '$model')"
  resp="$(curl -s -w $'\n__CAW_HTTP__%{http_code}' --connect-timeout 5 --max-time 30 \
    "https://api.anthropic.com/v1/messages" \
    -H "Content-Type: application/json" \
    -H "anthropic-version: 2023-06-01" \
    -H "anthropic-beta: oauth-2025-04-20" \
    -H "Authorization: Bearer $token" \
    -d "$body" 2>/dev/null)"
  [[ -z "$resp" ]] && { _caw_log WARN "HTTP opener: empty response (network error)"; return 4; }
  code="${resp##*__CAW_HTTP__}"
  json="${resp%$'\n'__CAW_HTTP__*}"

  case "$code" in
    200)
      text="$(jq -r '[.content[]?.text] | join(" ")' <<< "$json" 2>/dev/null)"
      stop="$(jq -r '.stop_reason // empty' <<< "$json" 2>/dev/null)"
      if [[ -n "$stop" || -n "$text" ]]; then
        _caw_log INFO "HTTP opener: request completed (stop_reason='${stop:-?}') → window anchored"
        (( show )) && print -r -- "reply: ${text:-<no text>}"
        return 0
      fi
      _caw_log WARN "HTTP opener: HTTP 200 but no completion in body"; return 4 ;;
    401|403)
      err="$(jq -r '.error.message // empty' <<< "$json" 2>/dev/null)"
      _caw_log WARN "HTTP opener: auth rejected ($code${err:+: $err}) — token likely expired; deferring to tmux opener"
      return 5 ;;
    400|404)
      err="$(jq -r '.error.message // empty' <<< "$json" 2>/dev/null)"
      if print -r -- "$err" | grep -qiE 'model'; then
        _caw_log WARN "HTTP opener: model '$model' rejected ($code${err:+: $err})"; return 6
      fi
      _caw_log WARN "HTTP opener: request rejected ($code${err:+: $err})"; return 4 ;;
    *)
      err="$(jq -r '.error.message // empty' <<< "$json" 2>/dev/null)"
      _caw_log WARN "HTTP opener: unexpected status $code${err:+ ($err)}"; return 4 ;;
  esac
}

# tmux strategy wrapper: send with the preferred (cheapest) model, falling back
# once to the account default model if that model got no reply — covers the rare
# case where the configured model/alias has been retired.
_caw_open_window_tmux() {
  emulate -L zsh
  local dir="$1" show="$2" rc primary
  primary="${CLAUDE_AUTO_WINDOW_MODEL-haiku}"
  _caw_send_starter "$dir" "$show" "$primary"; rc=$?
  if (( rc == 4 )) && [[ -n "$primary" ]]; then
    _caw_log WARN "no reply with model '$primary' (retired?); retrying on the account default model"
    _caw_send_starter "$dir" "$show" ""; rc=$?
  fi
  return $rc
}

# http strategy wrapper: send via raw HTTP with a concrete model id. A rejected
# model (rc 6) becomes a fall-back request (rc 5) — the API has no "account
# default" concept, so the tmux opener (which does) takes over.
_caw_open_window_http() {
  emulate -L zsh
  local dir="$1" show="$2" rc model
  model="${CLAUDE_AUTO_WINDOW_HTTP_MODEL:-claude-haiku-4-5-20251001}"
  _caw_send_starter_http "$dir" "$show" "$model"; rc=$?
  (( rc == 6 )) && { _caw_log WARN "HTTP opener: model '$model' rejected — deferring to tmux opener"; return 5; }
  return $rc
}

# Open a window using the selected strategy (CLAUDE_AUTO_WINDOW_OPENER):
#   http (default) — one raw POST /v1/messages (no tmux, no claude binary)
#   tmux           — drive a real interactive claude session in a throwaway tmux
# The http opener falls back to tmux (rc 5) whenever it can't authenticate or
# the request is rejected — so the token self-heal is preserved either way.
_caw_open_window() {
  emulate -L zsh
  local dir="$1" show="$2" rc
  local opener="${CLAUDE_AUTO_WINDOW_OPENER:-http}"
  case "$opener" in
    tmux)
      _caw_open_window_tmux "$dir" "$show"; rc=$? ;;
    http)
      _caw_open_window_http "$dir" "$show"; rc=$?
      if (( rc == 5 )); then
        _caw_log WARN "HTTP opener could not proceed; falling back to the tmux opener (self-heals token + sends)"
        _caw_open_window_tmux "$dir" "$show"; rc=$?
      fi ;;
    *)
      _caw_log ERROR "unknown CLAUDE_AUTO_WINDOW_OPENER '$opener' (use: tmux | http)"; return 2 ;;
  esac
  # Reply received ⇒ the request completed ⇒ a window is open. Stamp the cooldown
  # marker so the daemon doesn't re-open during the endpoint's propagation lag.
  (( rc == 0 )) && _caw_mark_opened "$dir"
  return $rc
}

# Best-effort confirmation that the window opened. The received reply is already
# proof the request completed (which is what opens the window); the usage
# endpoint can lag a few minutes before it reflects that. So this is purely
# informational and NEVER fails the run just because the endpoint hasn't caught
# up yet — a genuine no-reply failure is already returned by _caw_send_starter.
_caw_verify_started() {
  emulate -L zsh
  local dir="$1"
  local delay="${CLAUDE_AUTO_WINDOW_VERIFY_DELAY_SECONDS:-3}"
  _caw_validate_uint CLAUDE_AUTO_WINDOW_VERIFY_DELAY_SECONDS "$delay" || return 0
  (( delay > 0 )) && sleep "$delay"
  if _caw_session_active "$dir"; then
    _caw_log INFO "Five-hour window confirmed open for $dir"
  else
    _caw_log INFO "Starter reply received (request completed → window opened); the usage endpoint hasn't reflected it yet — it can lag a few minutes. Treating as success."
  fi
  return 0
}

# ============================================================================
# claude-profile integration — serial / parked accounts (http-only)
# ============================================================================
# claude-profile (github.com/deviationist/claude-profile) runs several
# subscriptions ("accounts") inside ONE Claude Code config dir, swapping only the
# OAuth credential; one account is "live" in the dir at a time, the rest "parked".
#
# A parked account's window CANNOT be anchored by the tmux opener — a real
# `claude` launch always uses whatever account is live in the dir, never a parked
# one. It can only be anchored by an HTTP request carrying THAT account's token.
# That request lives inside claude-profile (which alone can safely mint a fresh
# token per account, live or parked, under its mutation lock) as its
# `anchor-window` porcelain, so the token never leaves it. So: serial/parked
# support is HTTP-ONLY by construction. claude-auto-window stays the orchestrator
# — it discovers accounts from claude-profile's config, applies the SAME
# window-check / balance-gate / breaker / cooldown / jitter logic per account
# (keyed by an account pseudo-path so every existing state helper is reused
# unchanged), and delegates the anchor to `claude-profile anchor-window`.
#
# Active when CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE is `auto` (default: use it iff its
# config + script are both found), `on` (require it), or `off` (ignore entirely —
# the escape hatch back to pure single-window/traditional behavior).
# ----------------------------------------------------------------------------
_caw_cp_py() {   # path to claude-profile.py (daemon runs headless; the zsh
  emulate -L zsh # `claude-profile` function isn't sourced there → invoke directly)
  local c="${CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE_PY:-}"
  [[ -n "$c" && -r "$c" ]] && { print -r -- "$c"; return 0; }
  [[ -n "${_CLAUDE_PROFILE_HOME:-}" && -r "${_CLAUDE_PROFILE_HOME}/claude-profile.py" ]] \
    && { print -r -- "${_CLAUDE_PROFILE_HOME}/claude-profile.py"; return 0; }
  local p
  for p in "$HOME/.zsh/claude-profile/claude-profile.py" \
           "$HOME/code/claude-profile/claude-profile.py" \
           "$HOME/code-private/claude-profile/claude-profile.py"; do
    [[ -r "$p" ]] && { print -r -- "$p"; return 0; }
  done
  return 1
}

_caw_cp_config() {
  emulate -L zsh
  print -r -- "${CLAUDE_PROFILE_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/claude-profile/config.json}"
}

# Active? auto = iff config + script present. on = required (warn if missing).
_caw_cp_active() {
  emulate -L zsh
  local mode="${CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE:-auto}"
  [[ "$mode" == off ]] && return 1
  command -v jq >/dev/null 2>&1 || return 1
  local cfg; cfg="$(_caw_cp_config)"
  if [[ ! -r "$cfg" ]] || ! _caw_cp_py >/dev/null 2>&1; then
    [[ "$mode" == on ]] && _caw_log WARN "CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE=on but claude-profile config/script not found"
    return 1
  fi
  return 0
}

_caw_cp_expand() { emulate -L zsh; local d="$1"; print -r -- "${d/#\~/$HOME}"; }

# Emit "<profile>\t<account>\t<realdir>" for every configured account. (Profiles
# without an accounts array contribute nothing — their live account is handled as
# an ordinary dir-target instead.)
_caw_cp_accounts() {
  emulate -L zsh
  local cfg; cfg="$(_caw_cp_config)"
  [[ -r "$cfg" ]] || return 1
  local p a d
  jq -r '.profiles | to_entries[] | .key as $p | (.value.dir // "") as $d
         | (.value.accounts // [])[] | "\($p)\t\(.)\t\($d)"' "$cfg" 2>/dev/null \
  | while IFS=$'\t' read -r p a d; do
      [[ -n "$a" && -n "$d" ]] && printf '%s\t%s\t%s\n' "$p" "$a" "$(_caw_cp_expand "$d")"
    done
}

# Account names (one per line) if a real config dir is a claude-profile profile
# WITH accounts; nothing otherwise.
_caw_cp_accounts_for_dir() {
  emulate -L zsh
  local want="${1%/}" p a d
  _caw_cp_accounts | while IFS=$'\t' read -r p a d; do
    [[ "${d%/}" == "$want" ]] && print -r -- "$a"
  done
}

# Every claude-profile profile's config dir (one per line), expanded — regardless
# of whether it declares accounts. Used to seed the no-selection target set so
# BOTH multi-profile (a dir per single-login profile) and serial (accounts inside
# a dir) profiles are covered; the resolver's expansion then turns the account-ful
# ones into per-account targets and leaves the account-less ones as dir-targets.
_caw_cp_profile_dirs() {
  emulate -L zsh
  local cfg d; cfg="$(_caw_cp_config)"
  [[ -r "$cfg" ]] || return 1
  jq -r '.profiles[] | .dir // empty' "$cfg" 2>/dev/null \
  | while IFS= read -r d; do [[ -n "$d" ]] && print -r -- "$(_caw_cp_expand "$d")"; done
}

# Raw usage JSON for an account (same schema as _caw_usage_json), via the
# claude-profile porcelain (which refreshes a parked account's token first).
# Non-zero + no output on any failure (caller treats it as "undetermined").
_caw_cp_usage_json() {
  emulate -L zsh
  local account="$1" py line json
  py="$(_caw_cp_py)" || return 3
  line="$(python3 "$py" usage-json --account "$account" 2>/dev/null)" || return 3
  json="${line#*$'\t'}"
  [[ -n "$json" && "$json" != "$line" ]] || return 3        # empty field / no tab
  jq -e 'type=="object" and (.error==null) and (.limits != null)' <<< "$json" >/dev/null 2>&1 || return 3
  print -r -- "$json"
}

# Anchor a window for an account via claude-profile. Returns:
#   0 anchored · 5 LIVE account but its token lapsed (caller may tmux-fallback) ·
#   4 could not anchor (parked/other) · 2 claude-profile not found.
_caw_cp_anchor() {
  emulate -L zsh
  local account="$1" py out f2 f4
  py="$(_caw_cp_py)" || { _caw_log ERROR "claude-profile.py not found"; return 2; }
  out="$(python3 "$py" anchor-window --account "$account" \
          --model "${CLAUDE_AUTO_WINDOW_HTTP_MODEL:-claude-haiku-4-5-20251001}" \
          --prompt "${CLAUDE_AUTO_WINDOW_PROMPT:-Reply with exactly: OK.}" 2>/dev/null)"
  f2="$(cut -f2 <<< "$out")"; f4="$(cut -f4 <<< "$out")"
  if [[ "$f2" == anchored ]]; then
    _caw_log INFO "claude-profile anchored a window for account '$account' ($f4)"
    return 0
  fi
  _caw_log WARN "claude-profile could not anchor account '$account': ${out:-<no output>}"
  [[ "$f4" == live ]] && return 5      # live token lapsed → a claude launch can refresh + anchor
  return 4
}

# Is <account> the LIVE account of <dir> (vs parked)? Read-only, no network —
# `accounts` is claude-profile's porcelain, emitting "<account>\t<state>\t<profile>"
# with state "active" for the live one.
#
# This matters because the two lapse-repairs are NOT interchangeable: a bare
# `claude` launch refreshes whatever account is live in the dir, so it can heal
# the live account and can do nothing at all for a parked one (whose credential
# lives in claude-profile's own store — claude-profile's keep-alive owns that).
_caw_cp_is_live() {
  emulate -L zsh
  local account="$1" dir="${2%/}" py profile state
  py="$(_caw_cp_py)" || return 1
  profile="$(_caw_cp_accounts | awk -F'\t' -v d="$dir" '$3==d{print $1; exit}')"
  [[ -n "$profile" ]] || return 1
  state="$(python3 "$py" accounts --profile "$profile" 2>/dev/null \
           | awk -F'\t' -v a="$account" '$1==a{print $2; exit}')"
  [[ "$state" == active ]]
}

# The account pseudo-path used to key every per-target state helper (lock, state,
# breaker, cooldown). Absolute, so ${x:a} in the keying helpers leaves it intact,
# and distinct from the dir's own key so a profile's live-dir target and its
# account targets never collide.
_caw_account_key() { emulate -L zsh; print -r -- "${1%/}/@account/${2}"; }

# Guarded per-account cycle (mirror of _caw_once_one, but sourcing the window
# state from claude-profile and delegating the anchor to it). Dispatched to from
# _caw_once_one when an account is pinned.
_caw_once_account() {
  emulate -L zsh
  local dir account key rc
  dir="$(_caw_check_dir)"; account="${CLAUDE_AUTO_WINDOW_CP_ACCOUNT}"
  key="$(_caw_account_key "$dir" "$account")"
  local label="account:${account}" model="${CLAUDE_AUTO_WINDOW_MODEL-haiku}"
  local jitter_max="${CLAUDE_AUTO_WINDOW_JITTER_MAX_SECONDS:-180}"
  local jitter_min="${CLAUDE_AUTO_WINDOW_JITTER_MIN_SECONDS:-0}"
  _caw_validate_uint CLAUDE_AUTO_WINDOW_JITTER_MAX_SECONDS "$jitter_max" || return $?
  _caw_validate_uint CLAUDE_AUTO_WINDOW_JITTER_MIN_SECONDS "$jitter_min" || return $?
  (( jitter_min > jitter_max )) && jitter_max=$jitter_min

  # Not due yet? A stored resets_at still in the future → exit with no fetch.
  local _sr _sre
  if _sr="$(_caw_state_get "$key" resets_at)" && [[ -n "$_sr" ]]; then
    _sre="$(_caw_iso_to_epoch "$_sr")"
    if [[ "$_sre" == <-> ]] && (( $(date +%s) < _sre )); then
      _caw_log INFO "[$account] window open until $_sr — not due yet, exiting"
      return 0
    fi
  fi

  local lock; lock="$(_caw_acquire_lock "$key")"; rc=$?
  (( rc == 75 )) && return 0
  (( rc != 0 )) && return "$rc"
  {
    if _caw_breaker_tripped "$key"; then
      _caw_log ERROR "[$account] disabled by sentinel $(_caw_state_file "$key" tripped) ($(_caw_breaker_reason "$key")) — not running. Re-enable: claude-auto-window --reset"
      return 3
    fi

    local json; json="$(_caw_cp_usage_json "$account")"; rc=$?
    (( rc == 0 )) && { _caw_session_from_json "$key" "$json" "$label"; rc=$?; } || rc=3
    # Undetermined + live = the same expired-access-token dead end the dir path
    # already self-heals (see _caw_once_one's rc 4 branch), which this path never
    # did: claude-profile deliberately won't refresh a live token, so without
    # this the account just reports "usage unavailable" every wake, forever.
    # The launch is prompt-less: nothing is sent, no window opens, nothing spent.
    # Only worth a launch if the stored token is actually unusable. If it is
    # still fresh (as the dir-target path proves whenever it reports state for
    # the same dir), then an unavailable usage lookup is a claude-profile-side
    # problem and no launch can fix it — without this guard we would relaunch
    # claude every single wake to no effect.
    local _trc; _caw_resolve_token "$dir" >/dev/null 2>&1; _trc=$?
    if (( rc == 3 && _trc != 0 )) && _caw_cp_is_live "$account" "$dir"; then
      _caw_log INFO "[$account] window state unavailable and this is the live account — refreshing its token with a bare claude launch (nothing sent), then re-checking"
      if _caw_refresh_token "$dir"; then
        json="$(_caw_cp_usage_json "$account")"; rc=$?
        (( rc == 0 )) && { _caw_session_from_json "$key" "$json" "$label"; rc=$?; } || rc=3
      fi
    fi
    if (( rc == 0 )); then
      _caw_breaker_reset "$key"
      _caw_log INFO "[$account] window already open; nothing to do"
      return 0
    elif (( rc == 2 )); then
      _caw_log WARN "[$account] no 5-hour session window on this account — nothing to keep open"
      return 70
    elif (( rc == 3 )); then
      _caw_log ERROR "[$account] could not determine window state (claude-profile usage unavailable)"
      return 1
    fi

    if _caw_recently_opened "$key"; then
      _caw_log INFO "[$account] opened a window recently; endpoint may be catching up — skipping"
      return 0
    fi
    if _caw_plan_exhausted "$json" "$model"; then
      _caw_log WARN "[$account] weekly plan allowance exhausted for '${model:-<account default>}'; skipping"
      return 0
    fi

    local delay; delay=$(( jitter_min + $(_caw_random "$(( jitter_max - jitter_min ))") ))
    if (( delay > 0 )); then
      _caw_log INFO "[$account] window closed; jittering ${delay}s (${jitter_min}-${jitter_max}s) before anchor"
      sleep "$delay"
    fi
    if json="$(_caw_cp_usage_json "$account")" && _caw_session_from_json "$key" "$json" "$label"; then
      _caw_breaker_reset "$key"
      _caw_log INFO "[$account] window opened during jitter; no anchor needed"
      return 0
    fi
    _caw_plan_exhausted "$json" "$model" && {
      _caw_log WARN "[$account] weekly plan allowance became exhausted during jitter; skipping"
      return 0
    }

    local fails max="${CLAUDE_AUTO_WINDOW_MAX_FAILURES:-3}"
    _caw_validate_uint CLAUDE_AUTO_WINDOW_MAX_FAILURES "$max" || return $?
    fails="$(_caw_breaker_count "$key")"
    if (( fails >= max )); then
      local reason="${fails} consecutive anchors did not register a 5-hour window"
      local sentinel; sentinel="$(_caw_state_file "$key" tripped)"
      _caw_breaker_trip "$key" "$reason"
      _caw_log ERROR "[$account] circuit breaker TRIPPED: $reason. Disabled via sentinel: $sentinel. Re-enable: claude-auto-window --reset"
      _caw_notify "claude-auto-window DISABLED for account $account: $reason.

Re-enable with:  claude-auto-window --reset
(or simply:      rm $sentinel)"
      return 3
    fi

    _caw_breaker_inc "$key" >/dev/null
    _caw_cp_anchor "$account"; rc=$?
    if (( rc == 5 )); then
      # LIVE account, token lapsed. Try the FREE repair first: a prompt-less
      # launch refreshes the credential without sending anything, after which
      # claude-profile can anchor over HTTP as usual. Only if that fails do we
      # fall back to the launch that also sends (parked accounts can't use
      # either — the launch acts on whichever account is live).
      _caw_log INFO "[$account] live token lapsed — refreshing it with a bare claude launch (nothing sent), then retrying the anchor"
      if _caw_refresh_token "$dir"; then
        _caw_cp_anchor "$account"; rc=$?
      fi
      if (( rc != 0 )); then
        _caw_log INFO "[$account] still cannot anchor — falling back to a tmux launch that refreshes and sends"
        _caw_open_window "$dir" 0; rc=$?
      fi
    fi
    (( rc == 0 )) || return "$rc"
    _caw_mark_opened "$key"
    if [[ "${CLAUDE_AUTO_WINDOW_VERIFY:-1}" == 1 ]]; then
      local vd="${CLAUDE_AUTO_WINDOW_VERIFY_DELAY_SECONDS:-3}"
      [[ "$vd" == <-> ]] && (( vd > 0 )) && sleep "$vd"
      if json="$(_caw_cp_usage_json "$account")" && _caw_session_from_json "$key" "$json" "$label"; then
        _caw_log INFO "[$account] five-hour window confirmed open"
      else
        _caw_log INFO "[$account] anchor completed (window opened); endpoint hasn't reflected it yet — treating as success"
      fi
    fi
    return 0
  } always {
    _caw_release_lock "$lock"
  }
}

# Immediate per-account anchor (mirror of _caw_run_one). Dispatched from
# _caw_run_one when an account is pinned.
_caw_run_account() {
  emulate -L zsh
  local dir account key rc verify="${CLAUDE_AUTO_WINDOW_VERIFY:-1}"
  dir="$(_caw_check_dir)"; account="${CLAUDE_AUTO_WINDOW_CP_ACCOUNT}"
  key="$(_caw_account_key "$dir" "$account")"
  local label="account:${account}"
  local lock; lock="$(_caw_acquire_lock "$key")"; rc=$?
  (( rc == 75 )) && { _caw_log WARN "another claude-auto-window is running for account $account"; return 75; }
  (( rc != 0 )) && return "$rc"
  {
    # The only --run guard: refuse only on the definitive no-5h-window signal.
    if [[ "${CLAUDE_AUTO_WINDOW_FORCE:-0}" != 1 ]]; then
      local gj; gj="$(_caw_cp_usage_json "$account")"
      if [[ -n "$gj" ]]; then
        _caw_session_from_json "$key" "$gj" "$label"; local sc=$?
        (( sc == 2 )) && { _caw_log WARN "account $account has no 5-hour window — refusing (use --force)"; return 70; }
      fi
    fi
    _caw_log INFO "[$account] run mode: anchoring one window (no checks, no jitter)"
    _caw_cp_anchor "$account"; rc=$?
    (( rc == 5 )) && { _caw_open_window "$dir" 1; rc=$?; }
    (( rc == 0 )) || return "$rc"
    _caw_mark_opened "$key"
    if (( verify )); then
      local vj; if vj="$(_caw_cp_usage_json "$account")" && _caw_session_from_json "$key" "$vj" "$label"; then
        _caw_log INFO "[$account] five-hour window confirmed open"
      else
        _caw_log INFO "[$account] anchor completed; endpoint lag — treating as success"
      fi
    fi
  } always {
    _caw_release_lock "$lock"
  }
}

# Per-account status line (mirror of _caw_status_line). Dispatched from
# _caw_status_one when an account is pinned.
_caw_status_account() {
  emulate -L zsh
  local dir account key json rc sc open session pct reset
  dir="$(_caw_check_dir)"; account="${CLAUDE_AUTO_WINDOW_CP_ACCOUNT}"
  key="$(_caw_account_key "$dir" "$account")"
  json="$(_caw_cp_usage_json "$account")"; rc=$?
  if (( rc != 0 )) || [[ -z "$json" ]]; then
    print -r -- "account=${_caw_c_bold}${account}${_caw_c_reset} ${_caw_c_dim}(dir=$dir)${_caw_c_reset} five_hour=${_caw_c_yellow}?${_caw_c_reset} ${_caw_c_dim}(claude-profile usage unavailable — token lapsed / offline?)${_caw_c_reset}"
    return 0
  fi
  _caw_session_from_json "$key" "$json" "account:$account"; sc=$?
  if (( sc == 2 )); then
    print -r -- "account=${_caw_c_bold}${account}${_caw_c_reset} ${_caw_c_dim}(dir=$dir)${_caw_c_reset} five_hour=${_caw_c_yellow}n/a${_caw_c_reset} ${_caw_c_dim}(no session window)${_caw_c_reset}"
    return 0
  fi
  (( sc == 0 )) && open=yes || open=no
  session="$(jq -c 'first(.limits[]? | select(.kind=="session")) // {}' <<< "$json" 2>/dev/null)"
  pct="$(jq -r '.percent // 0'       <<< "$session")"
  reset="$(jq -r '.resets_at // "?"' <<< "$session")"
  local c_open; [[ "$open" == yes ]] && c_open="$_caw_c_green" || c_open="$_caw_c_yellow"
  print -r -- "account=${_caw_c_bold}${account}${_caw_c_reset} ${_caw_c_dim}(dir=$dir)${_caw_c_reset} five_hour_open=${c_open}${open}${_caw_c_reset} percent=$pct resets_at=${_caw_c_dim}${reset}${_caw_c_reset}"
  local model="${CLAUDE_AUTO_WINDOW_MODEL-haiku}" wpct verdict
  wpct="$(jq -r 'first(.limits[]? | select(.kind=="weekly_all")) | .percent // "?"' <<< "$json" 2>/dev/null)"
  if _caw_plan_exhausted "$json" "$model"; then
    verdict="${_caw_c_yellow}WOULD SKIP${_caw_c_reset} — starter model '${model:-<account default>}' off-plan"
  else
    verdict="${_caw_c_green}would fire${_caw_c_reset} — starter model '${model:-<account default>}' on plan"
  fi
  print -r -- "  weekly_all=${wpct}%  →  $verdict"
  local ssr; ssr="$(_caw_state_get "$key" resets_at 2>/dev/null)"
  [[ -n "$ssr" && "$ssr" != "$reset" ]] && print -r -- "${_caw_c_dim}  daemon-stored resets_at=$ssr${_caw_c_reset}"
  if _caw_breaker_tripped "$key"; then
    print -r -- "  ${_caw_c_red}${_caw_c_bold}⚠ DISABLED (sentinel present):${_caw_c_reset} $(_caw_state_file "$key" tripped)"
    print -r -- "${_caw_c_dim}    reason: $(_caw_breaker_reason "$key")${_caw_c_reset}"
    print -r -- "${_caw_c_dim}    re-enable: claude-auto-window --reset${_caw_c_reset}"
  fi
}

# Per-account breaker reset (mirror of _caw_reset_one).
_caw_reset_account() {
  emulate -L zsh
  local dir account key
  dir="$(_caw_check_dir)"; account="${CLAUDE_AUTO_WINDOW_CP_ACCOUNT}"
  key="$(_caw_account_key "$dir" "$account")"
  _caw_breaker_clear "$key"
  _caw_log INFO "Circuit breaker cleared for account $account — will resume on the next run"
}

# ============================================================================
# Public entry points
# ============================================================================

# Immediately fire one starter for the pinned profile — no checks, no jitter.
# Single-profile body; the public claude-auto-window-run iterates it.
_caw_run_one() {
  emulate -L zsh
  [[ -n "${CLAUDE_AUTO_WINDOW_CP_ACCOUNT:-}" ]] && { _caw_run_account; return $?; }
  local dir lock rc verify="${CLAUDE_AUTO_WINDOW_VERIFY:-1}"
  dir="$(_caw_check_dir)"
  lock="$(_caw_acquire_lock "$dir")"; rc=$?
  (( rc == 75 )) && { _caw_log WARN "another claude-auto-window is running for $dir"; return 75; }
  (( rc != 0 )) && return "$rc"
  {
    # The only guard in --run: refuse if this account has NO 5-hour window at all
    # (usage-billed/API seat), since firing there just spends money for nothing.
    # Fail-open on everything else (active/closed/undetermined/token-expired) so
    # --run stays the "just do it" path (an expired access token is refreshed by
    # the launch itself). --force / CLAUDE_AUTO_WINDOW_FORCE=1 bypasses even this.
    if [[ "${CLAUDE_AUTO_WINDOW_FORCE:-0}" != 1 ]]; then
      _caw_session_active "$dir"; rc=$?
      if (( rc == 2 )); then
        _caw_log WARN "No 5-hour session window on this account ($dir) — refusing to fire (would spend money for no benefit). Use --force to override."
        return 70
      fi
    fi
    _caw_log INFO "run mode: firing one starter (no checks, no jitter)"
    _caw_open_window "$dir" 1 || return $?
    (( verify )) && _caw_verify_started "$dir"
  } always {
    _caw_release_lock "$lock"
  }
}

# Guarded cycle for the pinned profile: check the window; only if none is open,
# jitter then fire. Single-profile body; the public claude-auto-window-once (and
# the daemon) iterate it across profiles.
_caw_once_one() {
  emulate -L zsh
  [[ -n "${CLAUDE_AUTO_WINDOW_CP_ACCOUNT:-}" ]] && { _caw_once_account; return $?; }
  local dir lock rc
  local jitter_max="${CLAUDE_AUTO_WINDOW_JITTER_MAX_SECONDS:-180}"
  local jitter_min="${CLAUDE_AUTO_WINDOW_JITTER_MIN_SECONDS:-0}"
  _caw_validate_uint CLAUDE_AUTO_WINDOW_JITTER_MAX_SECONDS "$jitter_max" || return $?
  _caw_validate_uint CLAUDE_AUTO_WINDOW_JITTER_MIN_SECONDS "$jitter_min" || return $?
  (( jitter_min > jitter_max )) && jitter_max=$jitter_min   # clamp: keep min <= max
  dir="$(_caw_check_dir)"

  # If we already know when to act next — a stored resets_at that hasn't passed —
  # exit early WITHOUT hitting the endpoint. This is what lets a per-minute cron
  # cost almost nothing: it only fetches near expiry and during the post-open
  # confirm phase (when the stored resets_at is the old, now-past value).
  local _sr _sre
  if _sr="$(_caw_state_get "$dir" resets_at)" && [[ -n "$_sr" ]]; then
    _sre="$(_caw_iso_to_epoch "$_sr")"
    if [[ "$_sre" == <-> ]] && (( $(date +%s) < _sre )); then
      _caw_log INFO "Window open until $_sr — not due yet, exiting"
      return 0
    fi
  fi

  lock="$(_caw_acquire_lock "$dir")"; rc=$?
  (( rc == 75 )) && return 0     # someone else has it; nothing to do
  (( rc != 0 )) && return "$rc"

  {
    # Circuit breaker already tripped by a prior run → refuse to run until reset.
    # (No re-notify here; the notification fired when it tripped.)
    if _caw_breaker_tripped "$dir"; then
      _caw_log ERROR "Disabled by sentinel $(_caw_state_file "$dir" tripped) ($(_caw_breaker_reason "$dir")) — not running. Re-enable: claude-auto-window --reset"
      return 3
    fi

    _caw_session_active "$dir"; rc=$?
    if (( rc == 4 )); then
      # Access token expired (>8h without a claude launch). This is NOT the
      # rc-3 hard-fail — it's self-healable with zero spend: a bare claude
      # launch (no prompt) refreshes the token within seconds, so do that and
      # re-run the state check with the fresh token. Only if the refresh
      # launch itself fails do we fall through on rc 4 to firing a starter
      # blind — the send also refreshes, worst case it costs one tiny message
      # inside an already-open window, and if the refresh token has expired
      # too (>~3 days idle) the no-reply trips the circuit breaker.
      _caw_log INFO "Access token expired — self-healing with a bare claude launch, then re-checking"
      if _caw_refresh_token "$dir"; then
        _caw_session_active "$dir"; rc=$?
      else
        _caw_log WARN "Self-heal launch did not refresh the token; falling back to firing a starter blind"
      fi
    fi
    if (( rc == 0 )); then
      _caw_breaker_reset "$dir"         # window confirmed open → healthy, clear the counter
      _caw_log INFO "Window already open for $dir; nothing to do"
      return 0
    elif (( rc == 2 )); then
      _caw_log WARN "No 5-hour session window on this account ($dir) — nothing to keep open. If this is an API/usage-billed seat, don't run claude-auto-window (it would spend money for no benefit)."
      return 70                         # sentinel: no window on this account (not an error)
    elif (( rc == 3 )); then
      _caw_log ERROR "Could not determine window state for $dir"
      return 1
    elif (( rc == 5 )); then
      # Rate-limited: the window state is unknown, NOT known-closed. Firing here
      # would anchor blindly on no evidence, so hold off until the next wake.
      _caw_log WARN "Usage endpoint is rate-limiting us (HTTP 429) for $dir — holding off until the next cycle"
      return 1
    elif (( rc == 4 )); then
      _caw_log INFO "Proceeding to fire the starter (its send refreshes the token; visibility returns next cycle)"
    fi

    # Endpoint-lag guard: the usage endpoint takes a few minutes to reflect a
    # freshly opened window, reading "closed" in the meantime. If we opened one
    # very recently, don't fire another starter conversation (the window is
    # already open — a repeat would just waste usage); wait for the endpoint.
    if _caw_recently_opened "$dir"; then
      _caw_log INFO "Opened a window recently; the usage endpoint may still be catching up — skipping"
      return 0
    fi

    # Window is closed. Balance gate: don't fire if the starter's model would be
    # off-plan (credit-billed / refused) — see _caw_plan_exhausted. The starter's
    # model is what decides which weekly plan bucket governs it.
    local model="${CLAUDE_AUTO_WINDOW_MODEL-haiku}"
    local json; json="$(_caw_usage_json "$dir")"
    if _caw_plan_exhausted "$json" "$model"; then
      _caw_log WARN "Weekly plan allowance exhausted for the starter model '${model:-<account default>}'; skipping (won't burn credits to anchor a window you'd have no plan allowance to use)"
      return 0
    fi

    # Jitter: we know we must open one, but wait a random min..max first so many
    # hosts / cron ticks don't stampede the endpoint at the same instant.
    local delay; delay=$(( jitter_min + $(_caw_random "$(( jitter_max - jitter_min ))") ))
    if (( delay > 0 )); then
      _caw_log INFO "Window closed; jittering ${delay}s (${jitter_min}-${jitter_max}s) before starter"
      sleep "$delay"
    fi

    # Normal activity during the jitter may already have opened the next window.
    _caw_session_active "$dir" && {
      _caw_breaker_reset "$dir"
      _caw_log INFO "Window opened during jitter (normal activity); no starter needed"
      return 0
    }
    json="$(_caw_usage_json "$dir")"
    _caw_plan_exhausted "$json" "$model" && {
      _caw_log WARN "Weekly plan allowance became exhausted during jitter; skipping starter"
      return 0
    }

    # Circuit breaker: if the last few opens never registered a window (endpoint
    # never showed it open), stop instead of looping forever. Notify + trip.
    local fails max="${CLAUDE_AUTO_WINDOW_MAX_FAILURES:-3}"
    _caw_validate_uint CLAUDE_AUTO_WINDOW_MAX_FAILURES "$max" || return $?
    fails="$(_caw_breaker_count "$dir")"
    if (( fails >= max )); then
      local reason="${fails} consecutive opens did not register a 5-hour window"
      local sentinel; sentinel="$(_caw_state_file "$dir" tripped)"
      _caw_breaker_trip "$dir" "$reason"
      _caw_log ERROR "Circuit breaker TRIPPED for $dir: $reason. Disabled via sentinel: $sentinel. Re-enable with: claude-auto-window --reset (or: rm $sentinel)"
      _caw_notify "claude-auto-window DISABLED for $dir: $reason.

The tool has stopped itself to avoid a wasteful loop and will not run again until re-enabled.
Sentinel file: $sentinel
Re-enable with:  claude-auto-window --reset
(or simply:      rm $sentinel)"
      return 3
    fi

    _caw_breaker_inc "$dir" >/dev/null   # count this attempt; reset happens once a window is confirmed open
    _caw_open_window "$dir" 0 || return $?
    _caw_verify_started "$dir"
  } always {
    _caw_release_lock "$lock"
  }
}

# Daemon: service every configured profile each wake, then sleep until the
# EARLIEST profile's window expires instead of polling on a fixed cadence. When a
# window is open we know exactly when it ends (that profile's stored resets_at),
# so we sleep until just after the soonest one — no polling in between. We only
# re-check at the fine interval to confirm a just-opened window (the endpoint lags
# a few minutes). A safety cap (MAX_SLEEP) bounds any single sleep.
#
# Multi-profile: profiles are serviced serially (a few minutes of serial jitter
# is irrelevant against 5-hour windows, and no background subshells keeps the
# lock/trap/log story simple). Each profile is failure-isolated and tracked
# independently in a disable map — "no-window" (rc 70; account type can't change,
# so a lifetime disable) or "breaker" (rc 3; disabled until its sentinel is
# cleared by --reset, re-checked cheaply each wake). The daemon exits 0 only when
# EVERY profile is disabled.
claude-auto-window-daemon() {
  emulate -L zsh
  local interval="${CLAUDE_AUTO_WINDOW_INTERVAL_SECONDS:-60}"
  _caw_validate_uint CLAUDE_AUTO_WINDOW_INTERVAL_SECONDS "$interval" || return $?
  (( interval >= 1 )) || { _caw_log ERROR "interval must be >= 1"; return 2; }
  local maxsleep="${CLAUDE_AUTO_WINDOW_MAX_SLEEP_SECONDS:-21600}"
  _caw_validate_uint CLAUDE_AUTO_WINDOW_MAX_SLEEP_SECONDS "$maxsleep" || return $?
  (( maxsleep < interval )) && maxsleep=$interval
  local buffer="${CLAUDE_AUTO_WINDOW_POST_EXPIRY_SECONDS:-5}"   # wake this long after expiry
  _caw_validate_uint CLAUDE_AUTO_WINDOW_POST_EXPIRY_SECONDS "$buffer" || return $?

  # Fail fast on persistent config errors so systemd's restart policy sees them.
  _caw_resolve_claude_bin >/dev/null || return $?
  _caw_resolve_profiles || { _caw_log ERROR "Invalid profile configuration; daemon exiting"; return 2; }

  local -a specs; specs=( "${_caw_profiles[@]}" )
  local spec d
  local -a dirs; for spec in "${specs[@]}"; do dirs+=( "$(_caw_profile_dir "$spec")" ); done

  local stop=0
  trap 'stop=1' INT TERM HUP

  _caw_log INFO "Daemon up: ${#specs} profile(s) [${(j:, :)dirs}]; sleeps until earliest window expiry (confirm poll ${interval}s, max sleep ${maxsleep}s), jitter ${CLAUDE_AUTO_WINDOW_JITTER_MIN_SECONDS:-0}-${CLAUDE_AUTO_WINDOW_JITTER_MAX_SECONDS:-180}s"
  typeset -A disabled          # check dir → "no-window" | "breaker"
  local rc sleep_for now_s sr sre cand summary
  while (( ! stop )); do
    # --- service every profile in turn (serial, per-profile isolation) ---
    for spec in "${specs[@]}"; do
      (( stop )) && break
      d="$(_caw_profile_dir "$spec")"
      # A breaker-disabled profile auto-re-enables once its sentinel is cleared
      # (--reset) — a cheap file test each wake, no daemon restart needed.
      if [[ "${disabled[$d]}" == breaker ]]; then
        if _caw_breaker_tripped "$d"; then
          continue                                   # still tripped → skip silently (already notified)
        fi
        unset "disabled[$d]"
        _caw_log INFO "Profile $d: breaker sentinel cleared — re-enabling"
      fi
      [[ "${disabled[$d]}" == no-window ]] && continue   # account type won't change → stay disabled

      _caw_pin_profile "$spec"
      _caw_once_one; rc=$?
      case "$rc" in
        2)  _caw_log ERROR "Fatal configuration error ($d); daemon exiting"; return 2 ;;
        70) disabled[$d]="no-window"
            _caw_log WARN "Profile $d has no 5-hour window (API/usage-billed seat?) — disabling it for the daemon's lifetime" ;;
        3)  disabled[$d]="breaker"
            _caw_log ERROR "Profile $d circuit breaker tripped — disabling until --reset clears its sentinel" ;;
        75) ;;                                        # another instance holds this profile's lock; fine
        0)  ;;
        *)  _caw_log WARN "Profile $d cycle failed (status $rc); will retry next wake" ;;
      esac
    done

    # --- all profiles disabled ⇒ nothing left to keep open ⇒ clean exit 0 ---
    # (preserves the single-profile invariant: systemd/launchd leave it stopped)
    local enabled=0
    for spec in "${specs[@]}"; do
      [[ -n "${disabled[$(_caw_profile_dir "$spec")]}" ]] || { enabled=1; break; }
    done
    if (( ! enabled )); then
      _caw_log WARN "All ${#specs} profile(s) disabled — daemon exiting (nothing to keep open)."
      return 0
    fi

    # --- sleep = min over ENABLED profiles of (resets_at+buffer-now | interval) ---
    # A not-due profile costs nothing on wake: _caw_once_one's stored-resets_at
    # early-exit returns without any network fetch. So we wake at the SOONEST
    # expiry; every other profile just no-ops until its own turn comes due.
    now_s=$(date +%s)
    sleep_for=$maxsleep
    summary=""
    for spec in "${specs[@]}"; do
      d="$(_caw_profile_dir "$spec")"
      [[ -n "${disabled[$d]}" ]] && { summary+=" ${d:t}=disabled"; continue; }
      cand=$interval
      if sr="$(_caw_state_get "$d" resets_at)" && [[ -n "$sr" ]] \
         && sre="$(_caw_iso_to_epoch "$sr")" && [[ "$sre" == <-> ]] && (( sre > now_s )); then
        cand=$(( sre + buffer - now_s ))                  # window open → sleep to expiry+buffer
        summary+=" ${d:t}=due@${sr:11:8}"
      else
        summary+=" ${d:t}=confirm"                        # closed / just-opened → poll at interval
      fi
      (( cand < 1 )) && cand=1
      (( cand < sleep_for )) && sleep_for=$cand
    done
    (( sleep_for > maxsleep )) && sleep_for=$maxsleep     # safety cap (clock drift / suspend)
    (( sleep_for < 1 )) && sleep_for=1
    _caw_log INFO "Sleeping ${sleep_for}s (min over profiles;${summary} )"
    (( stop )) || sleep "$sleep_for" || true
  done
  _caw_log INFO "Daemon stopped"
  return 0
}

# ----------------------------------------------------------------------------
# --check — the health gate. `--status` DESCRIBES state and always exits 0;
# `--check` JUDGES it and exits non-zero, so a timer can page on it.
#
# This exists because every failure this tool has actually had was silent: a
# tripped breaker sat unnoticed for ten days, and a workstation whose
# claude-profile had no `oauth` block logged "usage unavailable" every wake for
# weeks while both subscriptions went unkept. Something always knew; nothing
# ever said.
#
# Verdicts: FAIL = broken, needs a human, exit 1. WARN = legitimate but worth
# seeing (plan exhausted, no 5h window, token expired-but-self-healing) — exit
# 0, because paging on these would train you to ignore it. PASS = healthy.
# ----------------------------------------------------------------------------
typeset -g _caw_check_failed=0

_caw_check_emit() {   # <PASS|WARN|FAIL> <label> <detail>
  emulate -L zsh
  local v="$1" label="$2" detail="$3" c=""
  case "$v" in
    PASS) c="$_caw_c_green" ;;
    WARN) c="$_caw_c_yellow" ;;
    FAIL) c="$_caw_c_red"; _caw_check_failed=1 ;;
  esac
  print -r -- "${c}${v}${_caw_c_reset}  ${_caw_c_bold}${label}${_caw_c_reset}  ${detail}"
}

# Environment-level checks, run once (not per profile).
_caw_check_env() {
  emulate -L zsh
  local b
  for b in jq curl; do
    command -v "$b" >/dev/null 2>&1 || _caw_check_emit FAIL "deps" "$b not found on PATH (hard dependency)"
  done
  # The claude binary is only needed for the tmux opener and the token
  # self-heal — the http opener runs without it, so this is a WARN.
  _caw_resolve_claude_bin >/dev/null 2>&1     || _caw_check_emit WARN "deps" "claude binary not found — the tmux opener and the token self-heal cannot run"
  # claude-profile active but with no OAuth endpoints configured: usage lookups
  # return nothing for every account and parked tokens can never be refreshed.
  # It fails silently, which is exactly why it is asserted here.
  if _caw_cp_active; then
    local cfg; cfg="$(_caw_cp_config)"
    jq -e '(.oauth.usage_url // "") != "" and (.oauth.token_url // "") != ""' "$cfg" >/dev/null 2>&1       || _caw_check_emit FAIL "claude-profile" "no oauth.usage_url / oauth.token_url in $cfg — per-account usage and parked-token refresh cannot work"
  fi
}

# One target's verdict. Handles both dir- and account-targets.
_caw_check_one() {
  emulate -L zsh
  local account="${CLAUDE_AUTO_WINDOW_CP_ACCOUNT:-}" dir key label json="" rc model
  dir="$(_caw_check_dir)"
  model="${CLAUDE_AUTO_WINDOW_MODEL-haiku}"
  if [[ -n "$account" ]]; then
    key="$(_caw_account_key "$dir" "$account")"; label="account:$account"
    json="$(_caw_cp_usage_json "$account")"; rc=$?
    (( rc == 0 )) && { _caw_session_from_json "$key" "$json" "$label"; rc=$?; } || rc=3
  else
    key="$dir"; label="$dir"
    _caw_session_active "$dir"; rc=$?
    (( rc == 0 || rc == 1 )) && json="$(_caw_usage_json "$dir")"
  fi

  # A tripped breaker outranks whatever the window happens to be doing: the
  # account may look fine precisely because YOU used it, while the tool has
  # been standing down for days.
  if _caw_breaker_tripped "$key"; then
    _caw_check_emit FAIL "$label" "circuit breaker tripped — $(_caw_breaker_reason "$key") — clear with: claude-auto-window --reset"
    return 0
  fi

  case "$rc" in
    0) _caw_check_emit PASS "$label" "window open until $(_caw_state_get "$key" resets_at 2>/dev/null)" ;;
    1) if [[ -n "$json" ]] && _caw_plan_exhausted "$json" "$model"; then
         _caw_check_emit WARN "$label" "window closed; standing down — weekly plan allowance exhausted for '${model:-<account default>}'"
       else
         _caw_check_emit PASS "$label" "window closed; will be opened on the next cycle"
       fi ;;
    2) _caw_check_emit WARN "$label" "no 5-hour window on this account (API/usage-billed seat?) — nothing to keep open" ;;
    4) _caw_check_emit WARN "$label" "access token expired — --once and the daemon self-heal this" ;;
    5) _caw_check_emit WARN "$label" "usage endpoint rate-limiting us (HTTP 429) — transient, state unknown this cycle" ;;
    *) if [[ -n "$account" ]]; then
         _caw_check_emit FAIL "$label" "window state undeterminable — claude-profile returned no usage (token lapsed, offline, or oauth not configured)"
       else
         _caw_check_emit FAIL "$label" "window state undeterminable — usage lookup failed (offline, or no stored credentials)"
       fi ;;
  esac
  return 0
}

# Single-profile status line; the public claude-auto-window-status iterates it.
_caw_status_one() {
  emulate -L zsh
  _caw_color_init
  [[ -n "${CLAUDE_AUTO_WINDOW_CP_ACCOUNT:-}" ]] && { _caw_status_account; return $?; }
  _caw_status_line "$(_caw_check_dir)"
}

# ----------------------------------------------------------------------------
# Public iterator wrappers — resolve the profile list, then run the matching
# single-profile body for each spec (pinning it first). They CONTINUE through
# every profile on failure (per-profile isolation) and return the FIRST non-zero
# rc seen (0 if all succeeded). This keeps the sourced API names working and
# gives cron/one-shot users multi-profile through a single invocation. The
# daemon does NOT use these — it has its own per-profile disable/sleep loop.
# ----------------------------------------------------------------------------
_caw_iterate() {   # $1 = the _one body to run for each pinned profile
  emulate -L zsh
  local body="$1" spec rc first=0
  _caw_resolve_profiles || return 2
  for spec in "${_caw_profiles[@]}"; do
    _caw_pin_profile "$spec"
    "$body"; rc=$?
    (( rc != 0 && first == 0 )) && first=$rc
  done
  return $first
}

claude-auto-window-run()    { emulate -L zsh; _caw_iterate _caw_run_one; }
claude-auto-window-once()   { emulate -L zsh; _caw_iterate _caw_once_one; }
claude-auto-window-status() { emulate -L zsh; _caw_iterate _caw_status_one; }
claude-auto-window-reset()  { emulate -L zsh; _caw_iterate _caw_reset_one; }

# Health gate: 0 = every target healthy, 1 = at least one FAIL. Unlike the other
# iterated modes this does not surface a per-target rc — the verdicts are the
# output, and the exit code is their aggregate.
claude-auto-window-check() {
  emulate -L zsh
  _caw_color_init
  _caw_check_failed=0
  _caw_check_env
  _caw_iterate _caw_check_one || true    # verdicts are the output; rc is aggregated below
  (( _caw_check_failed )) && return 1
  return 0
}

# ----------------------------------------------------------------------------
# Profile specs — the multi-profile substrate. A "spec" is a single string that
# is EITHER the literal `default` (unpinned — Claude Code resolves ~/.claude on
# its own; we never set CLAUDE_CONFIG_DIR) OR an absolute config dir (pinned).
# The daemon and the iterator wrappers hold a list of these in the global array
# `_caw_profiles` and service each one in turn by pinning it into the ambient
# env the (untouched) single-profile bodies already read.
# ----------------------------------------------------------------------------
# NAME → spec. Mirrors the old _caw_apply_profile mapping, but PRINTS the spec
# instead of mutating env. Unknown name → error rc 2 (same message as before).
_caw_profile_spec() {
  emulate -L zsh
  local name="$1"
  # Prefer claude-profile's OWN config for name→dir, so the two tools never
  # diverge (a claude-profile `personal` → ~/.claude must not be shadowed by a
  # stale builtin guess). Falls through to the builtin map when claude-profile
  # isn't active or doesn't define that profile.
  if [[ -n "$name" && "$name" != default && "$name" != /* ]] && _caw_cp_active; then
    local cpdir; cpdir="$(jq -r --arg n "$name" '.profiles[$n].dir // empty' "$(_caw_cp_config)" 2>/dev/null)"
    [[ -n "$cpdir" ]] && { print -r -- "$(_caw_cp_expand "$cpdir")"; return 0; }
  fi
  case "$name" in
    ""|default)  print -r -- default ;;                     # let Claude resolve ~/.claude
    /*)          print -r -- "${name%/}" ;;                 # absolute path
    *)           _caw_log ERROR "unknown --profile '$name' (use 'default', an absolute path, or a claude-profile profile name)"; return 2 ;;
  esac
}

# spec → concrete check dir (the usage endpoint always needs a real path). The
# `default` spec maps to ~/.claude — Claude Code's own default profile, which is
# also what _caw_check_dir falls back to. Used for state-file keying and dedup.
_caw_profile_dir() {
  emulate -L zsh
  local spec="$1"
  # Account spec `cpacct:<account>:<dir>` → its account pseudo-key (this is the
  # value the daemon/iterators use for the disable map, breaker, resets_at and
  # dedup — all keying, never a real path op).
  if [[ "$spec" == cpacct:* ]]; then
    local rest="${spec#cpacct:}"
    _caw_account_key "${rest#*:}" "${rest%%:*}"; return 0
  fi
  [[ "$spec" == default ]] && { print -r -- "$HOME/.claude"; return 0; }
  print -r -- "${spec%/}"
}

# Pin a spec into the ambient env so the single-profile bodies act on it. The
# `default` spec UNsets CLAUDE_AUTO_WINDOW_CONFIG_DIR so _caw_launch_profile_pinned
# stays false and the launch remains a transparent passthrough (never sets
# CLAUDE_CONFIG_DIR); any other spec pins it.
_caw_pin_profile() {
  emulate -L zsh
  local spec="$1"
  # Account spec `cpacct:<account>:<dir>` → pin the dir AND the account, so the
  # single-profile bodies dispatch to their _account variants.
  if [[ "$spec" == cpacct:* ]]; then
    local rest="${spec#cpacct:}"
    typeset -gx CLAUDE_AUTO_WINDOW_CONFIG_DIR="${${rest#*:}%/}"
    typeset -gx CLAUDE_AUTO_WINDOW_CP_ACCOUNT="${rest%%:*}"
    return 0
  fi
  unset CLAUDE_AUTO_WINDOW_CP_ACCOUNT
  if [[ "$spec" == default ]]; then
    unset CLAUDE_AUTO_WINDOW_CONFIG_DIR
  else
    typeset -gx CLAUDE_AUTO_WINDOW_CONFIG_DIR="$spec"
  fi
}

# Populate the global `_caw_profiles` array once, by precedence:
#   1. already non-empty (CLI --profile/--config-dir appended specs) → keep
#   2. CLAUDE_AUTO_WINDOW_PROFILES (comma- and/or space-separated names/paths)
#   3. CLAUDE_AUTO_WINDOW_CONFIG_DIR set (legacy single-profile env) → one spec
#   4. fallback → a single `default`
# Then dedup by concrete check dir (first occurrence wins; WARN on the repeat —
# e.g. `--profile default --config-dir ~/.claude` both resolve to ~/.claude).
# Returns non-zero if any name in CLAUDE_AUTO_WINDOW_PROFILES was unresolvable.
_caw_resolve_profiles() {
  emulate -L zsh
  typeset -ga _caw_profiles
  local -a out
  local sp d name rc=0
  if (( ${#_caw_profiles} )); then
    out=( "${_caw_profiles[@]}" )
  elif [[ -n "${CLAUDE_AUTO_WINDOW_PROFILES:-}" ]]; then
    local -a raw; raw=( ${(s: :)${CLAUDE_AUTO_WINDOW_PROFILES//,/ }} )
    for name in "${raw[@]}"; do
      sp="$(_caw_profile_spec "$name")" || { rc=2; continue; }
      out+=( "$sp" )
    done
  elif [[ -n "${CLAUDE_AUTO_WINDOW_CONFIG_DIR:-}" ]]; then
    out=( "${CLAUDE_AUTO_WINDOW_CONFIG_DIR%/}" )
  elif _caw_cp_active; then
    # No explicit selection + claude-profile active → seed one spec per configured
    # profile dir (a dir==~/.claude becomes the `default` passthrough). The
    # expansion below turns account-ful profiles into per-account targets and
    # leaves single-login (account-less) profiles as plain dir-targets — so both
    # serial and multi-profile setups are covered.
    local pdir got=0
    while IFS= read -r pdir; do
      [[ -z "$pdir" ]] && continue
      if [[ "${pdir%/}" == "$HOME/.claude" ]]; then out+=( default ); else out+=( "${pdir%/}" ); fi
      got=1
    done < <(_caw_cp_profile_dirs)
    (( got )) || out=( default )
  else
    out=( default )
  fi

  # Expand any dir-spec that is a claude-profile profile WITH accounts into one
  # account-spec per account, so an explicitly-selected serial profile (or the
  # default ~/.claude when it's serial) keeps ALL its subscriptions open. A
  # dir-spec with no matching claude-profile accounts stays a plain dir-target
  # (traditional single-window behavior).
  if _caw_cp_active; then
    local -a exp accts; local s acct real
    for s in "${out[@]}"; do
      if [[ "$s" == cpacct:* ]]; then exp+=( "$s" ); continue; fi
      real="$(_caw_profile_dir "$s")"                     # default→~/.claude, dir→dir
      accts=( ${(f)"$(_caw_cp_accounts_for_dir "$real")"} )
      if (( ${#accts} )); then
        for acct in "${accts[@]}"; do exp+=( "cpacct:${acct}:${real%/}" ); done
      else
        exp+=( "$s" )
      fi
    done
    out=( "${exp[@]}" )
  fi

  local -A seen
  _caw_profiles=()
  for sp in "${out[@]}"; do
    d="$(_caw_profile_dir "$sp")"
    if [[ -n "${seen[$d]:-}" ]]; then
      _caw_log WARN "Duplicate profile resolving to $d (spec '$sp') — ignoring the repeat"
      continue
    fi
    seen[$d]=1
    _caw_profiles+=( "$sp" )
  done
  return $rc
}

_caw_usage_text() {
  cat <<'USAGE'
claude-auto-window — keep a Claude five-hour window perpetually open

Two opener strategies (--opener, default http):
  http   Anchor the window with ONE raw POST /v1/messages using the OAuth token
         Claude Code already stored — no tmux, no claude binary. Lightest path
         (the default). Falls back to the tmux opener when the token is
         expired/absent (only a real claude launch can refresh it) or the
         request is auth-rejected.
  tmux   Drive a real interactive claude session in a throwaway tmux session.
         Heaviest but most faithful; self-heals an expired token on its own.

Usage:
  claude-auto-window [--once]            # check window; if closed, jitter + open (default)
  claude-auto-window --run               # open one now, no checks, no jitter
  claude-auto-window --daemon            # keep windows open; sleeps until expiry
  claude-auto-window --status            # print current five-hour session state
  claude-auto-window --reset             # clear a tripped circuit breaker
  claude-auto-window --check             # health gate: exit 1 if anything is broken

Profile (repeatable — one daemon/run holds N accounts open):
  --config-dir PATH        Explicit Claude profile dir (pins CLAUDE_CONFIG_DIR)
  --profile NAME           default | <abs path> | a claude-profile profile name
                           (default = let Claude Code resolve ~/.claude; other
                           NAMES resolve from claude-profile's config, defined
                           per-machine there — not hardcoded here.)
                           Repeat either flag to service several profiles, e.g.
                           --profile default --profile <name>. Or set
                           CLAUDE_AUTO_WINDOW_PROFILES="a b" once.
                           Each profile is checked/opened independently with
                           per-profile failure isolation; --status prints one
                           block per profile (with the balance-gate verdict).

Tuning (all also settable via CLAUDE_AUTO_WINDOW_* env, or a config file at
$XDG_CONFIG_HOME/claude-auto-window/config):
  --interval SEC           Daemon confirm-poll interval — how often to re-check
                           while waiting for the endpoint to reflect a just-opened
                           window. (Open windows are slept-through, not polled.)
                                                               Default: 60
  --post-expiry SEC        Daemon wakes this long after a window's expiry to fire
                           the next starter.                   Default: 5
  --max-sleep SEC          Cap on a single sleep (safety).     Default: 21600
  --jitter-max SEC         Upper bound of the random wait before firing. Keep
                           small on a single daemon for tight windows. Default: 180
  --jitter-min SEC         Lower bound of the random wait before firing. Default: 0
  --reply-timeout SEC      How long to wait for the reply.     Default: 120
  --verify-delay SEC       Delay before post-open verify.      Default: 3
  --prompt TEXT            Starter prompt. Default: "Reply with exactly: OK."
  --expect TEXT            Reply token to look for.            Default: "OK."
  --expect-count N         Reply occurrences required, after the prompt-echo
                           lines are filtered out.             Default: 1
  --model MODEL            Model alias or id for the tmux opener. Default: haiku
                           (cheapest tier, alias tracks the latest version).
                           "" = account default. Falls back to the account
                           default if the chosen model has been retired.
  --opener STRATEGY        Window opener: http | tmux.            Default: http
                           http = one raw POST /v1/messages (no tmux/binary),
                           falling back to tmux when the token needs refreshing.
  --http-model ID          CONCRETE model id for the http opener (the CLI's
                           "haiku" alias is not valid on the API).
                                                  Default: claude-haiku-4-5-20251001
  --claude-profile MODE    claude-profile integration: auto | on | off.
                           auto (default) = keep EVERY serial subscription's
                           window open when claude-profile's config + script are
                           found (parked accounts included — http only). on =
                           require it (warn if missing). off = ignore it (pure
                           single-window / traditional behavior).
  --claude-profile-py PATH Path to claude-profile.py (auto-discovered if unset).
  --starter-dir PATH       Working dir for the starter (isolated from the work
                           cwd). Default: $TMPDIR/claude-auto-window-<uid>.
  --claude-bin PATH        Absolute path to the claude executable.
  --tmux-socket NAME       Isolated tmux socket name (-L).     Default: claude-auto-window
  --color MODE             Colorize --status output: auto | always | never.
                           auto (default) = only when stdout is a TTY. Log
                           output is never colorized. NO_COLOR always wins.
  --log PATH               Also append logs here (stdout/stderr always on).
  --no-verify              Skip the post-open window verification.
  --quiet                  Suppress console output (log to --log file only).
                           Use for cron so it doesn't email on every run; rely
                           on --notify-cmd for the trip alert.
  --force                  With --run, fire even on an account that has no
                           5-hour window (bypasses the only --run safety check).
  --max-failures N         Consecutive opens that never register a window before
                           the circuit breaker trips + stops.        Default: 3
  --weekly-max-percent N   Balance gate: skip the starter once the weekly plan
                           bucket governing the starter model reaches N% (so we
                           never burn usage credits to anchor a window). Lower it
                           (e.g. 97) for a safety margin.             Default: 100
  --notify-cmd CMD         Shell command run when the breaker trips (message on
                           stdin and in $CLAUDE_AUTO_WINDOW_MESSAGE). e.g. a
                           notify-send / mail / ntfy / osascript one-liner.
  -h, --help               Show this help.
  -v, --version            Show version.

--check verdicts:
  PASS  healthy.
  WARN  legitimate but worth seeing (plan exhausted, no 5-hour window, access
        token expired-but-self-healing). Does NOT affect the exit code.
  FAIL  broken, needs a human (tripped breaker, undeterminable window state,
        missing dependency, claude-profile without its oauth endpoints).
  Exit 0 unless at least one FAIL — so it can drive a timer that only pages
  when something is actually wrong.

Source-able API:
  source ./claude-auto-window
  claude-auto-window-run | -once | -daemon | -status | -check
USAGE
}

# ----------------------------------------------------------------------------
# CLI entrypoint — maps flags onto the CLAUDE_AUTO_WINDOW_* env the funcs read.
# ----------------------------------------------------------------------------
_caw_main() {
  emulate -L zsh
  setopt local_options

  # Load a config file first (lowest priority): fills CLAUDE_AUTO_WINDOW_* vars
  # not already set in the environment; CLI flags below override both.
  _caw_load_config

  # --profile / --config-dir are REPEATABLE: each occurrence appends a spec to
  # the profile list (in order given), so one invocation can service N profiles.
  typeset -ga _caw_profiles; _caw_profiles=()
  local mode="once" mode_set=0 _sp
  while (( $# )); do
    case "$1" in
      --run|--open-now)  [[ $mode_set == 1 && $mode != run ]] && { print -u2 "pick one mode"; return 2; }; mode=run; mode_set=1 ;;
      --once)            [[ $mode_set == 1 && $mode != once ]] && { print -u2 "pick one mode"; return 2; }; mode=once; mode_set=1 ;;
      --daemon)          [[ $mode_set == 1 && $mode != daemon ]] && { print -u2 "pick one mode"; return 2; }; mode=daemon; mode_set=1 ;;
      --status)          [[ $mode_set == 1 && $mode != status ]] && { print -u2 "pick one mode"; return 2; }; mode=status; mode_set=1 ;;
      --reset)           [[ $mode_set == 1 && $mode != reset ]] && { print -u2 "pick one mode"; return 2; }; mode=reset; mode_set=1 ;;
      --check)           [[ $mode_set == 1 && $mode != check ]] && { print -u2 "pick one mode"; return 2; }; mode=check; mode_set=1 ;;
      --no-verify)       typeset -gx CLAUDE_AUTO_WINDOW_VERIFY=0 ;;
      --quiet)           typeset -gx CLAUDE_AUTO_WINDOW_QUIET=1 ;;
      --force)           typeset -gx CLAUDE_AUTO_WINDOW_FORCE=1 ;;
      --max-failures)    typeset -gx CLAUDE_AUTO_WINDOW_MAX_FAILURES="$2"; shift ;;
      --max-failures=*)  typeset -gx CLAUDE_AUTO_WINDOW_MAX_FAILURES="${1#*=}" ;;
      --weekly-max-percent)   typeset -gx CLAUDE_AUTO_WINDOW_WEEKLY_MAX_PERCENT="$2"; shift ;;
      --weekly-max-percent=*) typeset -gx CLAUDE_AUTO_WINDOW_WEEKLY_MAX_PERCENT="${1#*=}" ;;
      --notify-cmd)      typeset -gx CLAUDE_AUTO_WINDOW_NOTIFY_CMD="$2"; shift ;;
      --notify-cmd=*)    typeset -gx CLAUDE_AUTO_WINDOW_NOTIFY_CMD="${1#*=}" ;;
      --profile)         _sp="$(_caw_profile_spec "$2")" || return $?; _caw_profiles+=( "$_sp" ); shift ;;
      --profile=*)       _sp="$(_caw_profile_spec "${1#*=}")" || return $?; _caw_profiles+=( "$_sp" ) ;;
      --config-dir)      _caw_profiles+=( "${2%/}" ); shift ;;
      --config-dir=*)    _sp="${1#*=}"; _caw_profiles+=( "${_sp%/}" ) ;;
      --interval)        typeset -gx CLAUDE_AUTO_WINDOW_INTERVAL_SECONDS="$2"; shift ;;
      --interval=*)      typeset -gx CLAUDE_AUTO_WINDOW_INTERVAL_SECONDS="${1#*=}" ;;
      --max-sleep)       typeset -gx CLAUDE_AUTO_WINDOW_MAX_SLEEP_SECONDS="$2"; shift ;;
      --max-sleep=*)     typeset -gx CLAUDE_AUTO_WINDOW_MAX_SLEEP_SECONDS="${1#*=}" ;;
      --post-expiry)     typeset -gx CLAUDE_AUTO_WINDOW_POST_EXPIRY_SECONDS="$2"; shift ;;
      --post-expiry=*)   typeset -gx CLAUDE_AUTO_WINDOW_POST_EXPIRY_SECONDS="${1#*=}" ;;
      --jitter-max)      typeset -gx CLAUDE_AUTO_WINDOW_JITTER_MAX_SECONDS="$2"; shift ;;
      --jitter-max=*)    typeset -gx CLAUDE_AUTO_WINDOW_JITTER_MAX_SECONDS="${1#*=}" ;;
      --jitter-min)      typeset -gx CLAUDE_AUTO_WINDOW_JITTER_MIN_SECONDS="$2"; shift ;;
      --jitter-min=*)    typeset -gx CLAUDE_AUTO_WINDOW_JITTER_MIN_SECONDS="${1#*=}" ;;
      --reply-timeout)   typeset -gx CLAUDE_AUTO_WINDOW_REPLY_TIMEOUT_SECONDS="$2"; shift ;;
      --reply-timeout=*) typeset -gx CLAUDE_AUTO_WINDOW_REPLY_TIMEOUT_SECONDS="${1#*=}" ;;
      --verify-delay)    typeset -gx CLAUDE_AUTO_WINDOW_VERIFY_DELAY_SECONDS="$2"; shift ;;
      --verify-delay=*)  typeset -gx CLAUDE_AUTO_WINDOW_VERIFY_DELAY_SECONDS="${1#*=}" ;;
      --prompt)          typeset -gx CLAUDE_AUTO_WINDOW_PROMPT="$2"; shift ;;
      --prompt=*)        typeset -gx CLAUDE_AUTO_WINDOW_PROMPT="${1#*=}" ;;
      --expect)          typeset -gx CLAUDE_AUTO_WINDOW_EXPECT="$2"; shift ;;
      --expect=*)        typeset -gx CLAUDE_AUTO_WINDOW_EXPECT="${1#*=}" ;;
      --expect-count)    typeset -gx CLAUDE_AUTO_WINDOW_EXPECT_COUNT="$2"; shift ;;
      --expect-count=*)  typeset -gx CLAUDE_AUTO_WINDOW_EXPECT_COUNT="${1#*=}" ;;
      --model)           typeset -gx CLAUDE_AUTO_WINDOW_MODEL="$2"; shift ;;
      --model=*)         typeset -gx CLAUDE_AUTO_WINDOW_MODEL="${1#*=}" ;;
      --opener)          typeset -gx CLAUDE_AUTO_WINDOW_OPENER="$2"; shift ;;
      --opener=*)        typeset -gx CLAUDE_AUTO_WINDOW_OPENER="${1#*=}" ;;
      --http-model)      typeset -gx CLAUDE_AUTO_WINDOW_HTTP_MODEL="$2"; shift ;;
      --http-model=*)    typeset -gx CLAUDE_AUTO_WINDOW_HTTP_MODEL="${1#*=}" ;;
      --claude-profile)     typeset -gx CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE="$2"; shift ;;
      --claude-profile=*)   typeset -gx CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE="${1#*=}" ;;
      --claude-profile-py)   typeset -gx CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE_PY="$2"; shift ;;
      --claude-profile-py=*) typeset -gx CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE_PY="${1#*=}" ;;
      --starter-dir)     typeset -gx CLAUDE_AUTO_WINDOW_STARTER_DIR="$2"; shift ;;
      --starter-dir=*)   typeset -gx CLAUDE_AUTO_WINDOW_STARTER_DIR="${1#*=}" ;;
      --claude-bin)      typeset -gx CLAUDE_AUTO_WINDOW_CLAUDE_BIN="$2"; shift ;;
      --claude-bin=*)    typeset -gx CLAUDE_AUTO_WINDOW_CLAUDE_BIN="${1#*=}" ;;
      --tmux-socket)     typeset -gx CLAUDE_AUTO_WINDOW_TMUX_SOCKET="$2"; shift ;;
      --tmux-socket=*)   typeset -gx CLAUDE_AUTO_WINDOW_TMUX_SOCKET="${1#*=}" ;;
      --color)           typeset -gx CLAUDE_AUTO_WINDOW_COLOR="$2"; shift ;;
      --color=*)         typeset -gx CLAUDE_AUTO_WINDOW_COLOR="${1#*=}" ;;
      --log)             typeset -gx CLAUDE_AUTO_WINDOW_LOG="$2"; shift ;;
      --log=*)           typeset -gx CLAUDE_AUTO_WINDOW_LOG="${1#*=}" ;;
      -h|--help)         _caw_usage_text; return 0 ;;
      -v|--version)      print -r -- "claude-auto-window $CLAUDE_AUTO_WINDOW_VERSION"; return 0 ;;
      --)                shift; break ;;
      *)                 print -u2 "claude-auto-window: unknown argument: $1 (see --help)"; return 2 ;;
    esac
    shift
  done

  # Profiles are resolved (env/config fallback + dedup) lazily by the iterator
  # wrappers and the daemon — CLI-appended specs above take precedence there.

  # Validate the opener strategy up front so a bad value fails fast (rather than
  # only at fire time, which for a daemon would repeat every cycle).
  case "${CLAUDE_AUTO_WINDOW_OPENER:-http}" in
    tmux|http) ;;
    *) print -u2 "claude-auto-window: --opener must be 'tmux' or 'http' (got: ${CLAUDE_AUTO_WINDOW_OPENER})"; return 2 ;;
  esac
  case "${CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE:-auto}" in
    auto|on|off) ;;
    *) print -u2 "claude-auto-window: --claude-profile must be 'auto', 'on', or 'off' (got: ${CLAUDE_AUTO_WINDOW_CLAUDE_PROFILE})"; return 2 ;;
  esac
  case "${CLAUDE_AUTO_WINDOW_COLOR:-auto}" in
    auto|always|never|1|0|yes|no) ;;
    *) print -u2 "claude-auto-window: --color must be 'auto', 'always' or 'never' (got: ${CLAUDE_AUTO_WINDOW_COLOR})"; return 2 ;;
  esac

  case "$mode" in
    run)    claude-auto-window-run ;;
    once)   claude-auto-window-once ;;
    daemon) claude-auto-window-daemon ;;
    status) claude-auto-window-status ;;
    reset)  claude-auto-window-reset ;;
    check)  claude-auto-window-check ;;
  esac
}

# Keep a stable public alias for the default (guarded) cycle.
claude-auto-window() { claude-auto-window-once "$@"; }

# Run the CLI only when executed directly, not when sourced.
# ZSH_EVAL_CONTEXT contains ':file' when this file is being sourced.
case ":${ZSH_EVAL_CONTEXT:-}:" in
  *:file:*) ;;                       # sourced → just define functions
  *) _caw_main "$@"; exit $? ;;      # executed → run CLI
esac
